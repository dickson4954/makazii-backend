import { Router } from "express";

import {
  requireAuth,
  requireMarketer,
} from "../middleware/authMiddleware";

import {
  getMarketerFeedback,
} from "../controllers/marketerFeedbackController";

const router = Router();

router.use(requireAuth);
router.use(requireMarketer);

router.get("/", getMarketerFeedback);

export default router;
