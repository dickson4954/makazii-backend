import type { Response } from "express";
import bcrypt from "bcryptjs";

import prisma from "../config/prisma";
import type { AuthenticatedRequest } from "../middleware/authMiddleware";

/**
 * PUBLIC → SUBMIT MARKETER APPLICATION
 *
 * POST /api/marketer-applications
 *
 * Applicants do not need an account.
 *
 * Geography rules:
 * - exactly one county
 * - exactly one constituency
 * - 1–2 wards
 * - constituency must belong to county
 * - wards must belong to constituency
 */
export async function submitMarketerApplication(
  req: AuthenticatedRequest,
  res: Response
) {
  try {
    const body = req.body ?? {};

    const {
      firstName,
      lastName,
      phone,
      email,

      idType,
      idNumber,
      idFrontUrl,
      idBackUrl,

      countyId,
      constituencyId,
      wardIds,
      placeIds,

      timeInSelectedAreas,

      hasRealEstateExperience,
      experienceAreas,
      experienceDuration,
      experienceDescription,

      currentOccupation,
      workingWithAnotherAgency,
      currentAgencyName,

      motivation,
      contribution,
      expectedPropertiesPerMonth,

      propertySources,
      knowsLandlords,
      approximateLandlordCount,

      comfortableCommunicating,
      communicationMethods,
      timeAvailability,
      willingToFollowProcedures,

      referenceName,
      referencePhone,
      referenceRelationship,

      declarationAccepted,
    } = body;

    /**
     * ---------------------------------------------------------
     * BASIC REQUIRED FIELD VALIDATION
     * ---------------------------------------------------------
     */

    const requiredStrings: Array<[string, unknown]> = [
      ["First name", firstName],
      ["Last name", lastName],
      ["Phone", phone],
      ["Email", email],
      ["ID number", idNumber],
      ["Time in selected areas", timeInSelectedAreas],
      ["Experience duration", experienceDuration],
      ["Experience description", experienceDescription],
      ["Current occupation", currentOccupation],
      ["Motivation", motivation],
      ["Contribution", contribution],
      ["Expected properties per month", expectedPropertiesPerMonth],
      ["Time availability", timeAvailability],
      ["Reference name", referenceName],
      ["Reference phone", referencePhone],
      ["Reference relationship", referenceRelationship],
    ];

    for (const [label, value] of requiredStrings) {
      if (typeof value !== "string" || !value.trim()) {
        return res.status(400).json({
          success: false,
          message: `${label} is required`,
        });
      }
    }

    if (idType !== "NATIONAL_ID" && idType !== "PASSPORT") {
      return res.status(400).json({
        success: false,
        message: "ID type must be NATIONAL_ID or PASSPORT",
      });
    }

    if (
      typeof hasRealEstateExperience !== "boolean" ||
      typeof workingWithAnotherAgency !== "boolean" ||
      typeof knowsLandlords !== "boolean" ||
      typeof comfortableCommunicating !== "boolean" ||
      typeof willingToFollowProcedures !== "boolean"
    ) {
      return res.status(400).json({
        success: false,
        message:
          "Experience, agency, landlord, communication, and procedure fields must be boolean values",
      });
    }

    if (declarationAccepted !== true) {
      return res.status(400).json({
        success: false,
        message: "You must accept the declaration before submitting",
      });
    }

    /**
     * ---------------------------------------------------------
     * EMAIL / PHONE
     * ---------------------------------------------------------
     */

    const normalizedEmail = email.trim().toLowerCase();
    const normalizedPhone = phone.trim();

    const existingUser = await prisma.user.findFirst({
      where: {
        OR: [
          {
            email: normalizedEmail,
          },
          {
            phone: normalizedPhone,
          },
        ],
      },
      select: {
        id: true,
        email: true,
        phone: true,
        role: true,
      },
    });

    if (existingUser) {
      return res.status(409).json({
        success: false,
        message:
          existingUser.email === normalizedEmail
            ? "An account with this email already exists"
            : "An account with this phone number already exists",
      });
    }

    /**
     * ---------------------------------------------------------
     * GEOGRAPHY VALIDATION
     * ---------------------------------------------------------
     */

    if (typeof countyId !== "string" || !countyId.trim()) {
      return res.status(400).json({
        success: false,
        message: "County is required",
      });
    }

    if (
      typeof constituencyId !== "string" ||
      !constituencyId.trim()
    ) {
      return res.status(400).json({
        success: false,
        message: "Constituency is required",
      });
    }

    const normalizedWardIds = Array.isArray(wardIds)
      ? [
          ...new Set(
            wardIds
              .filter((id): id is string => typeof id === "string")
              .map((id) => id.trim())
              .filter(Boolean)
          ),
        ]
      : [];

    if (
      normalizedWardIds.length < 1 ||
      normalizedWardIds.length > 2
    ) {
      return res.status(400).json({
        success: false,
        message: "Select between 1 and 2 wards",
      });
    }

    const county = await prisma.county.findUnique({
      where: {
        id: countyId.trim(),
      },
      select: {
        id: true,
        name: true,
      },
    });

    if (!county) {
      return res.status(400).json({
        success: false,
        message: "Selected county does not exist",
      });
    }

    const constituency = await prisma.constituency.findUnique({
      where: {
        id: constituencyId.trim(),
      },
      select: {
        id: true,
        name: true,
        countyId: true,
      },
    });

    if (!constituency) {
      return res.status(400).json({
        success: false,
        message: "Selected constituency does not exist",
      });
    }

    if (constituency.countyId !== county.id) {
      return res.status(400).json({
        success: false,
        message:
          "Selected constituency does not belong to the selected county",
      });
    }

    const wards = await prisma.ward.findMany({
      where: {
        id: {
          in: normalizedWardIds,
        },
      },
      select: {
        id: true,
        name: true,
        constituencyId: true,
      },
    });

    if (wards.length !== normalizedWardIds.length) {
      const foundIds = new Set(wards.map((ward) => ward.id));

      const missingWardIds = normalizedWardIds.filter(
        (id) => !foundIds.has(id)
      );

      return res.status(400).json({
        success: false,
        message: "One or more selected wards do not exist",
        data: {
          missingWardIds,
        },
      });
    }

    const invalidWards = wards.filter(
      (ward) => ward.constituencyId !== constituency.id
    );

    if (invalidWards.length > 0) {
      return res.status(400).json({
        success: false,
        message:
          "One or more selected wards do not belong to the selected constituency",
        data: {
          invalidWardIds: invalidWards.map((ward) => ward.id),
        },
      });
    }

    /**
     * ---------------------------------------------------------
     * APPLICATION-SPECIFIC VALIDATION
     * ---------------------------------------------------------
     */

    const normalizedPlaceIds = Array.isArray(placeIds)
      ? [
          ...new Set(
            placeIds
              .filter((id): id is string => typeof id === "string")
              .map((id) => id.trim())
              .filter(Boolean)
          ),
        ]
      : [];

    if (normalizedPlaceIds.length > 0) {
      const places = await prisma.place.findMany({
        where: {
          id: {
            in: normalizedPlaceIds,
          },
        },
        select: {
          id: true,
        },
      });

      if (places.length !== normalizedPlaceIds.length) {
        const foundIds = new Set(places.map((place) => place.id));

        const missingPlaceIds = normalizedPlaceIds.filter(
          (id) => !foundIds.has(id)
        );

        return res.status(400).json({
          success: false,
          message: "One or more selected places do not exist",
          data: {
            missingPlaceIds,
          },
        });
      }
    }

    /**
     * ---------------------------------------------------------
     * DUPLICATE ACTIVE APPLICATION CHECK
     * ---------------------------------------------------------
     */

    const existingApplication =
      await prisma.marketerApplication.findFirst({
        where: {
          OR: [
            {
              email: normalizedEmail,
            },
            {
              phone: normalizedPhone,
            },
          ],
          status: {
            in: ["PENDING", "UNDER_REVIEW", "ACTION_REQUIRED"],
          },
        },
        select: {
          id: true,
          email: true,
          phone: true,
          status: true,
        },
      });

    if (existingApplication) {
      return res.status(409).json({
        success: false,
        message:
          "You already have an active marketer application under review",
      });
    }

    /**
     * ---------------------------------------------------------
     * CREATE APPLICATION
     * ---------------------------------------------------------
     */

    const application = await prisma.marketerApplication.create({
      data: {
        firstName: firstName.trim(),
        lastName: lastName.trim(),
        phone: normalizedPhone,
        email: normalizedEmail,

        idType,
        idNumber: idNumber.trim(),
        idFrontUrl:
          typeof idFrontUrl === "string" && idFrontUrl.trim()
            ? idFrontUrl.trim()
            : null,
        idBackUrl:
          typeof idBackUrl === "string" && idBackUrl.trim()
            ? idBackUrl.trim()
            : null,

        countyId: county.id,
        constituencyId: constituency.id,
        wardIds: normalizedWardIds,
        placeIds: normalizedPlaceIds,

        timeInSelectedAreas: timeInSelectedAreas.trim(),

        hasRealEstateExperience,
        experienceAreas: Array.isArray(experienceAreas)
          ? experienceAreas.filter(
              (value): value is string =>
                typeof value === "string" && Boolean(value.trim())
            )
          : [],
        experienceDuration: experienceDuration.trim(),
        experienceDescription: experienceDescription.trim(),

        currentOccupation: currentOccupation.trim(),
        workingWithAnotherAgency,
        currentAgencyName:
          typeof currentAgencyName === "string" &&
          currentAgencyName.trim()
            ? currentAgencyName.trim()
            : null,

        motivation: motivation.trim(),
        contribution: contribution.trim(),
        expectedPropertiesPerMonth:
          expectedPropertiesPerMonth.trim(),

        propertySources: Array.isArray(propertySources)
          ? propertySources.filter(
              (value): value is string =>
                typeof value === "string" && Boolean(value.trim())
            )
          : [],

        knowsLandlords,
        approximateLandlordCount:
          typeof approximateLandlordCount === "number"
            ? approximateLandlordCount
            : null,

        comfortableCommunicating,
        communicationMethods: Array.isArray(communicationMethods)
          ? communicationMethods.filter(
              (value): value is string =>
                typeof value === "string" && Boolean(value.trim())
            )
          : [],
        timeAvailability: timeAvailability.trim(),
        willingToFollowProcedures,

        referenceName: referenceName.trim(),
        referencePhone: referencePhone.trim(),
        referenceRelationship: referenceRelationship.trim(),

        declarationAccepted: true,
      },
      select: {
        id: true,
        firstName: true,
        lastName: true,
        email: true,
        phone: true,
        countyId: true,
        constituencyId: true,
        wardIds: true,
        status: true,
        createdAt: true,
      },
    });

    return res.status(201).json({
      success: true,
      message:
        "Your marketer application has been submitted successfully",
      data: {
        application,
        geography: {
          county: {
            id: county.id,
            name: county.name,
          },
          constituency: {
            id: constituency.id,
            name: constituency.name,
          },
          wards: wards.map((ward) => ({
            id: ward.id,
            name: ward.name,
          })),
        },
      },
    });
  } catch (error) {
    console.error(
      "submitMarketerApplication error:",
      error
    );

    return res.status(500).json({
      success: false,
      message: "Failed to submit marketer application",
    });
  }
}

/**
 * -------------------------------------------------------------
 * ADMIN → LIST APPLICATIONS
 * -------------------------------------------------------------
 *
 * GET /api/admin/marketer-applications
 */
export async function getMarketerApplications(
  req: AuthenticatedRequest,
  res: Response
) {
  try {
    const status =
      typeof req.query.status === "string"
        ? req.query.status
        : undefined;

    const applications =
      await prisma.marketerApplication.findMany({
        where: status
          ? {
              status: status as
                | "PENDING"
                | "UNDER_REVIEW"
                | "ACTION_REQUIRED"
                | "APPROVED"
                | "REJECTED",
            }
          : undefined,
        orderBy: {
          createdAt: "desc",
        },
      });

    return res.json({
      success: true,
      count: applications.length,
      data: applications,
    });
  } catch (error) {
    console.error(
      "getMarketerApplications error:",
      error
    );

    return res.status(500).json({
      success: false,
      message: "Failed to load marketer applications",
    });
  }
}

/**
 * -------------------------------------------------------------
 * ADMIN → GET APPLICATION
 * -------------------------------------------------------------
 *
 * GET /api/admin/marketer-applications/:id
 */
export async function getMarketerApplication(
  req: AuthenticatedRequest,
  res: Response
) {
  try {
    const id = req.params.id as string;

    const application =
      await prisma.marketerApplication.findUnique({
        where: {
          id,
        },
      });

    if (!application) {
      return res.status(404).json({
        success: false,
        message: "Marketer application not found",
      });
    }

    return res.json({
      success: true,
      data: application,
    });
  } catch (error) {
    console.error(
      "getMarketerApplication error:",
      error
    );

    return res.status(500).json({
      success: false,
      message: "Failed to load marketer application",
    });
  }
}

/**
 * -------------------------------------------------------------
 * ADMIN → MARK APPLICATION UNDER REVIEW
 * -------------------------------------------------------------
 *
 * PATCH /api/admin/marketer-applications/:id/review
 */
export async function reviewMarketerApplication(
  req: AuthenticatedRequest,
  res: Response
) {
  try {
    const id = req.params.id as string;

    const application =
      await prisma.marketerApplication.findUnique({
        where: {
          id,
        },
      });

    if (!application) {
      return res.status(404).json({
        success: false,
        message: "Marketer application not found",
      });
    }

    if (
      application.status === "APPROVED" ||
      application.status === "REJECTED"
    ) {
      return res.status(400).json({
        success: false,
        message: `This application is already ${application.status.toLowerCase()}`,
      });
    }

    const updated =
      await prisma.marketerApplication.update({
        where: {
          id,
        },
        data: {
          status: "UNDER_REVIEW",
          reviewedAt: new Date(),
        },
      });

    return res.json({
      success: true,
      message: "Application marked as under review",
      data: updated,
    });
  } catch (error) {
    console.error(
      "reviewMarketerApplication error:",
      error
    );

    return res.status(500).json({
      success: false,
      message: "Failed to review marketer application",
    });
  }
}

/**
 * -------------------------------------------------------------
 * ADMIN → REQUEST CHANGES
 * -------------------------------------------------------------
 *
 * PATCH /api/admin/marketer-applications/:id/request-changes
 */
export async function requestMarketerApplicationChanges(
  req: AuthenticatedRequest,
  res: Response
) {
  try {
    const id = req.params.id as string;
    const { requestedChanges, adminNotes } = req.body ?? {};

    if (
      typeof requestedChanges !== "string" ||
      !requestedChanges.trim()
    ) {
      return res.status(400).json({
        success: false,
        message: "Requested changes are required",
      });
    }

    const application =
      await prisma.marketerApplication.findUnique({
        where: {
          id,
        },
      });

    if (!application) {
      return res.status(404).json({
        success: false,
        message: "Marketer application not found",
      });
    }

    if (
      application.status === "APPROVED" ||
      application.status === "REJECTED"
    ) {
      return res.status(400).json({
        success: false,
        message:
          "This application can no longer be changed",
      });
    }

    const updated =
      await prisma.marketerApplication.update({
        where: {
          id,
        },
        data: {
          status: "ACTION_REQUIRED",
          requestedChanges: requestedChanges.trim(),
          adminNotes:
            typeof adminNotes === "string" &&
            adminNotes.trim()
              ? adminNotes.trim()
              : application.adminNotes,
          reviewedAt: new Date(),
        },
      });

    return res.json({
      success: true,
      message: "Application changes requested",
      data: updated,
    });
  } catch (error) {
    console.error(
      "requestMarketerApplicationChanges error:",
      error
    );

    return res.status(500).json({
      success: false,
      message: "Failed to request application changes",
    });
  }
}

/**
 * -------------------------------------------------------------
 * ADMIN → REJECT APPLICATION
 * -------------------------------------------------------------
 *
 * PATCH /api/admin/marketer-applications/:id/reject
 */
export async function rejectMarketerApplication(
  req: AuthenticatedRequest,
  res: Response
) {
  try {
    const id = req.params.id as string;
    const { rejectionReason, adminNotes } = req.body ?? {};

    if (
      typeof rejectionReason !== "string" ||
      !rejectionReason.trim()
    ) {
      return res.status(400).json({
        success: false,
        message: "Rejection reason is required",
      });
    }

    const application =
      await prisma.marketerApplication.findUnique({
        where: {
          id,
        },
      });

    if (!application) {
      return res.status(404).json({
        success: false,
        message: "Marketer application not found",
      });
    }

    if (application.status === "APPROVED") {
      return res.status(400).json({
        success: false,
        message:
          "An approved application cannot be rejected",
      });
    }

    const updated =
      await prisma.marketerApplication.update({
        where: {
          id,
        },
        data: {
          status: "REJECTED",
          rejectionReason: rejectionReason.trim(),
          adminNotes:
            typeof adminNotes === "string" &&
            adminNotes.trim()
              ? adminNotes.trim()
              : application.adminNotes,
          rejectedAt: new Date(),
          reviewedAt: new Date(),
        },
      });

    return res.json({
      success: true,
      message: "Marketer application rejected",
      data: updated,
    });
  } catch (error) {
    console.error(
      "rejectMarketerApplication error:",
      error
    );

    return res.status(500).json({
      success: false,
      message: "Failed to reject marketer application",
    });
  }
}

/**
 * -------------------------------------------------------------
 * ADMIN → APPROVE APPLICATION
 * -------------------------------------------------------------
 *
 * PATCH /api/admin/marketer-applications/:id/approve
 *
 * Creates:
 * 1. User
 * 2. Marketer
 * 3. MarketerCoverage
 *
 * Then activates the marketer account.
 */
export async function approveMarketerApplication(
  req: AuthenticatedRequest,
  res: Response
) {
  try {
    const id = req.params.id as string;

    const application =
      await prisma.marketerApplication.findUnique({
        where: {
          id,
        },
      });

    if (!application) {
      return res.status(404).json({
        success: false,
        message: "Marketer application not found",
      });
    }

    if (application.status === "APPROVED") {
      return res.status(400).json({
        success: false,
        message: "This application is already approved",
      });
    }

    if (application.status === "REJECTED") {
      return res.status(400).json({
        success: false,
        message:
          "A rejected application cannot be approved",
      });
    }

    /**
     * ---------------------------------------------------------
     * RECHECK GEOGRAPHY BEFORE APPROVAL
     * ---------------------------------------------------------
     */

    const county = await prisma.county.findUnique({
      where: {
        id: application.countyId,
      },
      select: {
        id: true,
        name: true,
      },
    });

    const constituency =
      await prisma.constituency.findUnique({
        where: {
          id: application.constituencyId,
        },
        select: {
          id: true,
          name: true,
          countyId: true,
        },
      });

    if (!county || !constituency) {
      return res.status(400).json({
        success: false,
        message:
          "The application's selected geography is no longer valid",
      });
    }

    if (constituency.countyId !== county.id) {
      return res.status(400).json({
        success: false,
        message:
          "The application's constituency does not belong to its county",
      });
    }

    const wardIds = [
      ...new Set(application.wardIds),
    ];

    if (wardIds.length < 1 || wardIds.length > 2) {
      return res.status(400).json({
        success: false,
        message:
          "The application must contain between 1 and 2 wards",
      });
    }

    const wards = await prisma.ward.findMany({
      where: {
        id: {
          in: wardIds,
        },
      },
      select: {
        id: true,
        name: true,
        constituencyId: true,
      },
    });

    if (wards.length !== wardIds.length) {
      return res.status(400).json({
        success: false,
        message:
          "One or more wards in the application no longer exist",
      });
    }

    if (
      wards.some(
        (ward) => ward.constituencyId !== constituency.id
      )
    ) {
      return res.status(400).json({
        success: false,
        message:
          "One or more application wards do not belong to the selected constituency",
      });
    }

    /**
     * ---------------------------------------------------------
     * CHECK COVERAGE CONFLICT
     * ---------------------------------------------------------
     *
     * Current business rule:
     * another marketer cannot already own any of these
     * selected geographic areas.
     */
    const existingCoverages =
      await prisma.marketerCoverage.findMany({
        where: {
          OR: [
            {
              countyId: county.id,
            },
            {
              constituencyId: constituency.id,
            },
          ],
        },
        include: {
          marketer: {
            include: {
              user: {
                select: {
                  firstName: true,
                  lastName: true,
                  email: true,
                  phone: true,
                },
              },
            },
          },
        },
      });

    const conflictingCoverage =
      existingCoverages.find((coverage) => {
        if (coverage.countyId !== county.id) {
          return false;
        }

        if (
          coverage.constituencyId !==
          constituency.id
        ) {
          return false;
        }

        return coverage.wardIds.some((wardId) =>
          wardIds.includes(wardId)
        );
      });

    if (conflictingCoverage) {
      return res.status(409).json({
        success: false,
        message:
          "One or more selected wards are already assigned to another marketer",
        data: {
          conflictingMarketer: {
            firstName:
              conflictingCoverage.marketer.user.firstName,
            lastName:
              conflictingCoverage.marketer.user.lastName,
          },
          county: county.name,
          constituency: constituency.name,
          conflictingWardIds:
            conflictingCoverage.wardIds.filter((wardId) =>
              wardIds.includes(wardId)
            ),
        },
      });
    }

    /**
     * ---------------------------------------------------------
     * CHECK ACCOUNT CONFLICT AGAIN
     * ---------------------------------------------------------
     */

    const existingUser = await prisma.user.findFirst({
      where: {
        OR: [
          {
            email: application.email,
          },
          {
            phone: application.phone,
          },
        ],
      },
      select: {
        id: true,
        email: true,
        phone: true,
        role: true,
      },
    });

    if (existingUser) {
      return res.status(409).json({
        success: false,
        message:
          "A user account already exists with this application's email or phone number",
        data: {
          existingUserRole: existingUser.role,
        },
      });
    }

    /**
     * ---------------------------------------------------------
     * TEMPORARY PASSWORD
     * ---------------------------------------------------------
     *
     * We generate a temporary password.
     *
     * We are not returning the password from this endpoint.
     *
     * Password delivery can be connected later to email/SMS.
     */
    const temporaryPassword =
      `${cryptoRandomString(10)}Aa1!`;

    const hashedPassword = await bcrypt.hash(
      temporaryPassword,
      12
    );

    /**
     * ---------------------------------------------------------
     * CREATE USER + MARKETER + COVERAGE
     * ---------------------------------------------------------
     */

    const result = await prisma.$transaction(
      async (tx) => {
        const user = await tx.user.create({
          data: {
            firstName: application.firstName,
            lastName: application.lastName,
            email: application.email,
            phone: application.phone,
            password: hashedPassword,
            role: "MARKETER",
            isActive: true,
          },
        });

        const marketer = await tx.marketer.create({
          data: {
            userId: user.id,
          },
        });

        const coverage =
          await tx.marketerCoverage.create({
            data: {
              marketerId: marketer.id,
              countyId: county.id,
              constituencyId: constituency.id,
              wardIds,
            },
          });

        const updatedApplication =
          await tx.marketerApplication.update({
            where: {
              id: application.id,
            },
            data: {
              status: "APPROVED",
              approvedAt: new Date(),
              reviewedAt:
                application.reviewedAt ?? new Date(),
            },
          });

        return {
          user,
          marketer,
          coverage,
          application: updatedApplication,
        };
      }
    );

    return res.json({
      success: true,
      message:
        "Marketer application approved and marketer account created",
      data: {
        application: result.application,
        marketer: {
          id: result.marketer.id,
          userId: result.user.id,
          firstName: result.user.firstName,
          lastName: result.user.lastName,
          email: result.user.email,
          phone: result.user.phone,
          role: result.user.role,
          isActive: result.user.isActive,
        },
        coverage: {
          county: county.name,
          constituency: constituency.name,
          wards: wards.map((ward) => ({
            id: ward.id,
            name: ward.name,
          })),
        },
      },
    });
  } catch (error) {
    console.error(
      "approveMarketerApplication error:",
      error
    );

    return res.status(500).json({
      success: false,
      message:
        "Failed to approve marketer application",
    });
  }
}

/**
 * Generate a cryptographically secure random string.
 *
 * This is intentionally kept local so approval does not
 * require another dependency.
 */
function cryptoRandomString(length: number): string {
  const chars =
    "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789";

  let result = "";

  for (let index = 0; index < length; index += 1) {
    result += chars.charAt(
      Math.floor(Math.random() * chars.length)
    );
  }

  return result;
}
