import { Request, Response } from "express";
import prisma from "../config/prisma";
import {
  PropertyPurpose,
  PropertyStatus,
  LongStayType,
  ShortStayType,
  StayMode,
  FurnishingType,
} from "@prisma/client";

type AuthenticatedRequest = Request & {
  user?: {
    userId: string;
    role: string;
    email: string;
  };
};

const ALLOWED_MARKETER_STATUSES: PropertyStatus[] = [
  PropertyStatus.DRAFT,
  PropertyStatus.PENDING_VERIFICATION,
  PropertyStatus.CHANGES_REQUIRED,
];

const LONG_STAY_TYPES: LongStayType[] = [
  LongStayType.SINGLE_ROOM,
  LongStayType.BEDSITTER,
  LongStayType.STUDIO,
  LongStayType.ONE_BEDROOM,
  LongStayType.TWO_BEDROOM,
  LongStayType.THREE_BEDROOM,
  LongStayType.FOUR_PLUS_BEDROOM,
  LongStayType.HOUSE,
  LongStayType.APARTMENT,
];

const SHORT_STAY_TYPES: ShortStayType[] = [
  ShortStayType.BNB,
  ShortStayType.LODGE,
  ShortStayType.GUEST_HOUSE,
  ShortStayType.HOTEL_ROOM,
  ShortStayType.SERVICED_APARTMENT,
  ShortStayType.FURNISHED_APARTMENT,
  ShortStayType.HOLIDAY_HOME,
  ShortStayType.VILLA,
  ShortStayType.COTTAGE,
  ShortStayType.HOSTEL,
  ShortStayType.PRIVATE_ROOM,
];

const STAY_MODES: StayMode[] = [
  StayMode.DAY,
  StayMode.OVERNIGHT,
  StayMode.DAY_AND_NIGHT,
  StayMode.FLEXIBLE,
];

const FURNISHING_TYPES: FurnishingType[] = [
  FurnishingType.UNFURNISHED,
  FurnishingType.SEMI_FURNISHED,
  FurnishingType.FURNISHED,
];

function getAuthenticatedUserId(req: AuthenticatedRequest): string | null {
  return req.user?.userId ?? null;
}

function parsePositiveInteger(
  value: unknown,
  fieldName: string,
  required = false,
): number | undefined {
  if (value === undefined || value === null || value === "") {
    if (required) {
      throw new Error(`${fieldName} is required`);
    }

    return undefined;
  }

  const parsed = Number(value);

  if (!Number.isInteger(parsed) || parsed < 0) {
    throw new Error(`${fieldName} must be a non-negative integer`);
  }

  return parsed;
}

function parseBoolean(
  value: unknown,
  fieldName: string,
  defaultValue?: boolean,
): boolean | undefined {
  if (value === undefined || value === null || value === "") {
    return defaultValue;
  }

  if (typeof value === "boolean") {
    return value;
  }

  if (value === "true" || value === "1") {
    return true;
  }

  if (value === "false" || value === "0") {
    return false;
  }

  throw new Error(`${fieldName} must be true or false`);
}

function normalizeString(value: unknown): string | undefined {
  if (typeof value !== "string") {
    return undefined;
  }

  const trimmed = value.trim();

  return trimmed.length > 0 ? trimmed : undefined;
}

function normalizeStringArray(value: unknown): string[] {
  if (Array.isArray(value)) {
    return value
      .filter((item): item is string => typeof item === "string")
      .map((item) => item.trim())
      .filter(Boolean);
  }

  if (typeof value === "string") {
    return value
      .split(",")
      .map((item) => item.trim())
      .filter(Boolean);
  }

  return [];
}

async function getMarketerFromUser(userId: string) {
  return prisma.marketer.findUnique({
    where: {
      userId,
    },
    include: {
      user: {
        select: {
          id: true,
          email: true,
          phone: true,
          firstName: true,
          lastName: true,
          isActive: true,
        },
      },
      coverage: {
        include: {
          county: true,
          constituency: true,
        },
      },
    },
  });
}

async function validateMarketerCoverage(
  marketerId: string,
  countyId: string,
  constituencyId: string,
  wardId: string,
) {
  const coverage = await prisma.marketerCoverage.findUnique({
    where: {
      marketerId,
    },
  });

  if (!coverage) {
    throw new Error(
      "This marketer does not have an approved coverage area.",
    );
  }

  if (coverage.countyId !== countyId) {
    throw new Error(
      "This property is outside the marketer's approved county coverage.",
    );
  }

  if (coverage.constituencyId !== constituencyId) {
    throw new Error(
      "This property is outside the marketer's approved constituency coverage.",
    );
  }

  if (!coverage.wardIds.includes(wardId)) {
    throw new Error(
      "This property is outside the marketer's approved ward coverage.",
    );
  }

  return coverage;
}

async function validateGeography(
  countyId: string,
  constituencyId: string,
  wardId: string,
) {
  const county = await prisma.county.findUnique({
    where: {
      id: countyId,
    },
  });

  if (!county) {
    throw new Error("Selected county was not found.");
  }

  const constituency = await prisma.constituency.findUnique({
    where: {
      id: constituencyId,
    },
  });

  if (!constituency) {
    throw new Error("Selected constituency was not found.");
  }

  if (constituency.countyId !== countyId) {
    throw new Error(
      "The selected constituency does not belong to the selected county.",
    );
  }

  const ward = await prisma.ward.findUnique({
    where: {
      id: wardId,
    },
  });

  if (!ward) {
    throw new Error("Selected ward was not found.");
  }

  if (ward.constituencyId !== constituencyId) {
    throw new Error(
      "The selected ward does not belong to the selected constituency.",
    );
  }

  return {
    county,
    constituency,
    ward,
  };
}

async function validateAmenities(amenityIds: string[]) {
  if (amenityIds.length === 0) {
    return [];
  }

  const amenities = await prisma.amenity.findMany({
    where: {
      id: {
        in: amenityIds,
      },
    },
  });

  const foundIds = new Set(amenities.map((amenity) => amenity.id));

  const missingIds = amenityIds.filter(
    (id) => !foundIds.has(id),
  );

  if (missingIds.length > 0) {
    throw new Error(
      `One or more selected amenities were not found: ${missingIds.join(", ")}`,
    );
  }

  return amenities;
}

/**
 * GET /api/marketer/properties
 *
 * Returns only properties belonging to the authenticated marketer.
 */
export async function getMarketerProperties(
  req: AuthenticatedRequest,
  res: Response,
) {
  try {
    const userId = getAuthenticatedUserId(req);

    if (!userId) {
      return res.status(401).json({
        success: false,
        message: "Authentication required.",
      });
    }

    const marketer = await getMarketerFromUser(userId);

    if (!marketer) {
      return res.status(403).json({
        success: false,
        message: "Marketer profile not found.",
      });
    }

    const search =
      typeof req.query.search === "string"
        ? req.query.search.trim()
        : "";

    const status =
      typeof req.query.status === "string"
        ? req.query.status.trim()
        : "";

    const where: any = {
      marketerId: marketer.id,
    };

    if (status) {
      if (!Object.values(PropertyStatus).includes(status as PropertyStatus)) {
        return res.status(400).json({
          success: false,
          message: `Invalid property status: ${status}`,
        });
      }

      where.status = status as PropertyStatus;
    }

    if (search) {
      where.OR = [
        {
          title: {
            contains: search,
            mode: "insensitive",
          },
        },
        {
          county: {
            contains: search,
            mode: "insensitive",
          },
        },
      ];
    }

    const properties = await prisma.property.findMany({
      where,
      orderBy: {
        updatedAt: "desc",
      },
      include: {
        countyRelation: true,
        constituency: true,
        ward: true,
        images: {
          orderBy: {
            createdAt: "asc",
          },
        },
        amenities: {
          include: {
            amenity: true,
          },
        },
        statusHistory: {
          orderBy: {
            createdAt: "desc",
          },
        },
        _count: {
          select: {
            viewingRequests: true,
            shortlists: true,
          },
        },
      },
    });

    return res.json({
      success: true,
      data: properties,
      count: properties.length,
    });
  } catch (error) {
    console.error("getMarketerProperties error:", error);

    return res.status(500).json({
      success: false,
      message: "Failed to load marketer properties.",
    });
  }
}

/**
 * GET /api/marketer/properties/:id
 *
 * Returns one property, but only when it belongs to the authenticated marketer.
 */
export async function getMarketerProperty(
  req: AuthenticatedRequest,
  res: Response,
) {
  try {
    const userId = getAuthenticatedUserId(req);

    if (!userId) {
      return res.status(401).json({
        success: false,
        message: "Authentication required.",
      });
    }

    const marketer = await getMarketerFromUser(userId);

    if (!marketer) {
      return res.status(403).json({
        success: false,
        message: "Marketer profile not found.",
      });
    }

    const property = await prisma.property.findFirst({
      where: {
        id: String(req.params.id),
        marketerId: marketer.id,
      },
      include: {
        countyRelation: true,
        constituency: true,
        ward: true,
        images: {
          orderBy: {
            createdAt: "asc",
          },
        },
        amenities: {
          include: {
            amenity: true,
          },
        },
        statusHistory: {
          orderBy: {
            createdAt: "desc",
          },
        },
        _count: {
          select: {
            viewingRequests: true,
