/**
 * POST /api/marketer/properties
 *
 * Creates a new property for the authenticated marketer.
 */
export async function createMarketerProperty(
  req: AuthenticatedRequest,
  res: Response,
) {
  try {
    const userId = getAuthenticatedUserId(req);

    if (!userId) {
      return res.status(401).json({
        success: false,
        message: "Authentication required.",
      });
    }

    const marketer = await getMarketerFromUser(userId);

    if (!marketer) {
      return res.status(403).json({
        success: false,
        message: "Marketer profile not found.",
      });
    }

    if (!marketer.user.isActive) {
      return res.status(403).json({
        success: false,
        message: "This marketer account is inactive.",
      });
    }

    const title = normalizeString(req.body.title);
    const description = normalizeString(req.body.description);

    const purpose =
      normalizeString(req.body.purpose)?.toUpperCase() as
        | PropertyPurpose
        | undefined;

    const longStayType =
      normalizeString(req.body.longStayType)?.toUpperCase() as
        | LongStayType
        | undefined;

    const shortStayType =
      normalizeString(req.body.shortStayType)?.toUpperCase() as
        | ShortStayType
        | undefined;

    const stayMode =
      normalizeString(req.body.stayMode)?.toUpperCase() as
        | StayMode
        | undefined;

    const furnishing =
      normalizeString(req.body.furnishing)?.toUpperCase() as
        | FurnishingType
        | undefined;

    const countyId = normalizeString(req.body.countyId);
    const constituencyId = normalizeString(req.body.constituencyId);
    const wardId = normalizeString(req.body.wardId);
    const placeId = normalizeString(req.body.placeId);

    if (!title) {
      return res.status(400).json({
        success: false,
        message: "Property title is required.",
      });
    }

    if (title.length < 3) {
      return res.status(400).json({
        success: false,
        message: "Property title must be at least 3 characters.",
      });
    }

    if (
      !purpose ||
      !Object.values(PropertyPurpose).includes(purpose)
    ) {
      return res.status(400).json({
        success: false,
        message: "A valid property purpose is required.",
      });
    }

    if (!countyId || !constituencyId || !wardId) {
      return res.status(400).json({
        success: false,
        message:
          "County, constituency and ward are all required.",
      });
    }

    if (purpose === PropertyPurpose.LONG_STAY) {
      if (
        !longStayType ||
        !LONG_STAY_TYPES.includes(longStayType)
      ) {
        return res.status(400).json({
          success: false,
          message:
            "A valid long-stay accommodation type is required.",
        });
      }
    }

    if (purpose === PropertyPurpose.SHORT_STAY) {
      if (
        !shortStayType ||
        !SHORT_STAY_TYPES.includes(shortStayType)
      ) {
        return res.status(400).json({
          success: false,
          message:
            "A valid short-stay accommodation type is required.",
        });
      }

      if (!stayMode || !STAY_MODES.includes(stayMode)) {
        return res.status(400).json({
          success: false,
          message: "A valid short-stay mode is required.",
        });
      }

    }

    if (
      furnishing !== undefined &&
      furnishing !== null &&
      !FURNISHING_TYPES.includes(furnishing)
    ) {
      return res.status(400).json({
        success: false,
        message: "Invalid furnishing type.",
      });
    }

    const monthlyRent = parsePositiveInteger(
      req.body.monthlyRent,
      "monthlyRent",
      purpose === PropertyPurpose.LONG_STAY,
    );

    const deposit = parsePositiveInteger(
      req.body.deposit,
      "deposit",
    );

    const viewingFee = parsePositiveInteger(
      req.body.viewingFee,
      "viewingFee",
    );

    
    if (
      purpose === PropertyPurpose.SHORT_STAY &&
      (viewingFee === undefined || viewingFee <= 0)
    ) {
      return res.status(400).json({
        success: false,
        message:
          "Viewing / inspection fee must be greater than zero.",
      });
    }

    const serviceCharge = parsePositiveInteger(
      req.body.serviceCharge,
      "serviceCharge",
    );

    const dayRate = parsePositiveInteger(
      req.body.dayRate,
      "dayRate",
    );

    const nightRate = parsePositiveInteger(
      req.body.nightRate,
      "nightRate",
    );

    const dayNightRate = parsePositiveInteger(
      req.body.dayNightRate,
      "dayNightRate",
    );

    const bedrooms = parsePositiveInteger(
      req.body.bedrooms,
      "bedrooms",
    );

    const bathrooms = parsePositiveInteger(
      req.body.bathrooms,
      "bathrooms",
    );

    const beds = parsePositiveInteger(
      req.body.beds,
      "beds",
    );

    const maxGuests = parsePositiveInteger(
      req.body.maxGuests,
      "maxGuests",
    );

    const rooms = parsePositiveInteger(
      req.body.rooms,
      "rooms",
    );

    if (
      purpose === PropertyPurpose.LONG_STAY &&
      (monthlyRent === undefined || monthlyRent <= 0)
    ) {
      return res.status(400).json({
        success: false,
        message: "Monthly rent must be greater than zero.",
      });
    }

    if (purpose === PropertyPurpose.SHORT_STAY) {
      if (
        stayMode === StayMode.DAY &&
        (dayRate === undefined || dayRate <= 0)
      ) {
        return res.status(400).json({
          success: false,
          message: "Day rate must be greater than zero.",
        });
      }

      if (
        stayMode === StayMode.OVERNIGHT &&
        (nightRate === undefined || nightRate <= 0)
      ) {
        return res.status(400).json({
          success: false,
          message: "Night rate must be greater than zero.",
        });
      }

      if (
        stayMode === StayMode.DAY_AND_NIGHT &&
        (dayNightRate === undefined || dayNightRate <= 0)
      ) {
        return res.status(400).json({
          success: false,
          message:
            "Day-and-night rate must be greater than zero.",
        });
      }

      if (
        stayMode === StayMode.FLEXIBLE &&
        !dayRate &&
        !nightRate &&
        !dayNightRate
      ) {
        return res.status(400).json({
          success: false,
          message:
            "At least one short-stay rate is required.",
        });
      }

      if (maxGuests === undefined || maxGuests <= 0) {
        return res.status(400).json({
          success: false,
          message: "Maximum guests must be greater than zero.",
        });
      }

      if (rooms === undefined || rooms <= 0) {
        return res.status(400).json({
          success: false,
          message: "Number of rooms must be greater than zero.",
        });
      }
    }

    const geography = await validateGeography(
      countyId,
      constituencyId,
      wardId,
    );

    await validateMarketerCoverage(
      marketer.id,
      countyId,
      constituencyId,
      wardId,
    );

    if (placeId) {
      const place = await prisma.place.findFirst({
        where: {
          id: placeId,
          countyId,
        },
      });

      if (!place) {
        return res.status(400).json({
          success: false,
          message:
            "Selected place does not belong to the selected county.",
        });
      }
    }

    const amenityIds = normalizeStringArray(
      req.body.amenityIds,
    );

    await validateAmenities(amenityIds);

    const available = parseBoolean(
      req.body.available,
      "available",
      true,
    );

    const property = await prisma.$transaction(async (tx) => {
      const created = await tx.property.create({
        data: {
          title,
          description,

          purpose,

          longStayType:
            purpose === PropertyPurpose.LONG_STAY
              ? longStayType
              : null,

          shortStayType:
            purpose === PropertyPurpose.SHORT_STAY
              ? shortStayType
              : null,

          status: PropertyStatus.DRAFT,

          monthlyRent:
            purpose === PropertyPurpose.LONG_STAY
              ? monthlyRent
              : null,

          deposit:
            purpose === PropertyPurpose.LONG_STAY
              ? deposit
              : null,

          viewingFee,

          serviceCharge:
            purpose === PropertyPurpose.LONG_STAY
              ? serviceCharge
              : null,

          dayRate:
            purpose === PropertyPurpose.SHORT_STAY
              ? dayRate
              : null,

          nightRate:
            purpose === PropertyPurpose.SHORT_STAY
              ? nightRate
              : null,

          dayNightRate:
            purpose === PropertyPurpose.SHORT_STAY
              ? dayNightRate
              : null,

          stayMode:
            purpose === PropertyPurpose.SHORT_STAY
              ? stayMode
              : null,

          bedrooms,
          bathrooms,
          beds:
            purpose === PropertyPurpose.SHORT_STAY
              ? beds
              : null,

          maxGuests:
            purpose === PropertyPurpose.SHORT_STAY
              ? maxGuests
              : null,

          rooms:
            purpose === PropertyPurpose.SHORT_STAY
              ? rooms
              : null,

          furnishing,

          countyId,
          constituencyId,
          wardId,

          county: geography.county.name,
          town: "",
          area: "",

          placeId: placeId ?? null,

          latitude: null,
          longitude: null,

          available,
          verified: false,

          createdById: userId,
          marketerId: marketer.id,

          amenities: {
            create: amenityIds.map((amenityId) => ({
              amenityId,
            })),
          },

          statusHistory: {
            create: {
              toStatus: PropertyStatus.DRAFT,
              note: "Property created by marketer",
              changedById: userId,
            },
          },
        },

        include: {
          countyRelation: true,
          constituency: true,
          ward: true,
          place: true,

          images: true,

          amenities: {
            include: {
              amenity: true,
            },
          },

          statusHistory: {
            orderBy: {
              createdAt: "desc",
            },
          },
        },
      });

      return created;
    });

    return res.status(201).json({
      success: true,
      message: "Property created successfully.",
      data: property,
    });
  } catch (error) {
    console.error("createMarketerProperty error:", error);

    const message =
      error instanceof Error
        ? error.message
        : "Failed to create property.";

    return res.status(400).json({
      success: false,
      message,
    });
  }
}

/**
 * PATCH /api/marketer/properties/:id
 *
 * Updates an owned property.
 *
 * Marketers cannot use this endpoint to publish/activate a property.
 */
export async function updateMarketerProperty(
  req: AuthenticatedRequest,
  res: Response,
) {
  try {
    const userId = getAuthenticatedUserId(req);

    if (!userId) {
      return res.status(401).json({
        success: false,
        message: "Authentication required.",
      });
    }

    const marketer = await getMarketerFromUser(userId);

    if (!marketer) {
      return res.status(403).json({
        success: false,
        message: "Marketer profile not found.",
      });
    }

    const existing = await prisma.property.findFirst({
      where: {
        id: String(req.params.id),
        marketerId: marketer.id,
      },
    });

    if (!existing) {
      return res.status(404).json({
        success: false,
        message: "Property not found.",
      });
    }

    if (existing.status === PropertyStatus.RENTED) {
      return res.status(400).json({
        success: false,
        message: "A rented property is locked and cannot be edited.",
      });
    }

    const purpose =
      req.body.purpose !== undefined
        ? (normalizeString(req.body.purpose)?.toUpperCase() as
            | PropertyPurpose
            | undefined)
        : existing.purpose;

    if (!purpose || !Object.values(PropertyPurpose).includes(purpose)) {
      return res.status(400).json({
        success: false,
        message: "Invalid property purpose.",
      });
    }

    const longStayType =
      req.body.longStayType !== undefined
        ? (normalizeString(req.body.longStayType)?.toUpperCase() as
            | LongStayType
            | undefined)
        : existing.longStayType;

    const shortStayType =
      req.body.shortStayType !== undefined
        ? (normalizeString(req.body.shortStayType)?.toUpperCase() as
            | ShortStayType
            | undefined)
        : existing.shortStayType;

    const stayMode =
      req.body.stayMode !== undefined
        ? (normalizeString(req.body.stayMode)?.toUpperCase() as
            | StayMode
            | undefined)
        : existing.stayMode;

    const furnishing =
      req.body.furnishing !== undefined
        ? (normalizeString(req.body.furnishing)?.toUpperCase() as
            | FurnishingType
            | undefined)
        : existing.furnishing;

    if (
      purpose === PropertyPurpose.LONG_STAY &&
      (!longStayType || !LONG_STAY_TYPES.includes(longStayType))
    ) {
      return res.status(400).json({
        success: false,
        message: "A valid long-stay property type is required.",
      });
    }

    if (
      purpose === PropertyPurpose.SHORT_STAY &&
      (!shortStayType || !SHORT_STAY_TYPES.includes(shortStayType))
    ) {
      return res.status(400).json({
        success: false,
        message: "A valid short-stay property type is required.",
      });
    }

    if (
      purpose === PropertyPurpose.SHORT_STAY &&
      stayMode !== undefined &&
      stayMode !== null &&
      !STAY_MODES.includes(stayMode)
    ) {
      return res.status(400).json({
        success: false,
        message: "Invalid short-stay mode.",
      });
    }

    
    if (
      furnishing !== undefined &&
      furnishing !== null &&
      !FURNISHING_TYPES.includes(furnishing)
    ) {
      return res.status(400).json({
        success: false,
        message: "Invalid furnishing type.",
      });
    }

    const title =
      req.body.title !== undefined
        ? normalizeString(req.body.title)
        : undefined;

    const description =
      req.body.description !== undefined
        ? normalizeString(req.body.description)
        : undefined;

    if (title !== undefined && title.length < 3) {
      return res.status(400).json({
        success: false,
        message: "Property title must be at least 3 characters.",
      });
    }

    const countyId =
      req.body.countyId !== undefined
        ? normalizeString(req.body.countyId)
        : existing.countyId;

    const constituencyId =
      req.body.constituencyId !== undefined
        ? normalizeString(req.body.constituencyId)
        : existing.constituencyId;

    const wardId =
      req.body.wardId !== undefined
        ? normalizeString(req.body.wardId)
        : existing.wardId;

    if (!countyId || !constituencyId || !wardId) {
      return res.status(400).json({
        success: false,
        message: "County, constituency and ward are all required.",
      });
    }

    const geographyChanged =
      countyId !== existing.countyId ||
      constituencyId !== existing.constituencyId ||
      wardId !== existing.wardId;

    const geography = geographyChanged
      ? await validateGeography(
          countyId,
          constituencyId,
          wardId,
        )
      : null;

    await validateMarketerCoverage(
      marketer.id,
      countyId,
      constituencyId,
      wardId,
    );

    const monthlyRent =
      req.body.monthlyRent !== undefined
        ? parsePositiveInteger(
            req.body.monthlyRent,
            "monthlyRent",
            true,
          )
        : existing.monthlyRent;

    const deposit =
      req.body.deposit !== undefined
        ? parsePositiveInteger(req.body.deposit, "deposit")
        : existing.deposit;

    const viewingFee =
      req.body.viewingFee !== undefined
        ? parsePositiveInteger(req.body.viewingFee, "viewingFee")
        : existing.viewingFee;

    
    if (
      purpose === PropertyPurpose.SHORT_STAY &&
      (viewingFee === undefined ||
        viewingFee === null ||
        viewingFee <= 0)
    ) {
      return res.status(400).json({
        success: false,
        message:
          "Viewing / inspection fee must be greater than zero.",
      });
    }


    const serviceCharge =
      req.body.serviceCharge !== undefined
        ? parsePositiveInteger(
            req.body.serviceCharge,
            "serviceCharge",
          )
        : existing.serviceCharge;

    const dayRate =
      req.body.dayRate !== undefined
        ? parsePositiveInteger(req.body.dayRate, "dayRate")
        : existing.dayRate;

    const nightRate =
      req.body.nightRate !== undefined
        ? parsePositiveInteger(req.body.nightRate, "nightRate")
        : existing.nightRate;

    const dayNightRate =
      req.body.dayNightRate !== undefined
        ? parsePositiveInteger(
            req.body.dayNightRate,
            "dayNightRate",
          )
        : existing.dayNightRate;

    if (
      purpose === PropertyPurpose.LONG_STAY &&
      (!monthlyRent || monthlyRent <= 0)
    ) {
      return res.status(400).json({
        success: false,
        message: "Monthly rent must be greater than zero.",
      });
    }

    if (purpose === PropertyPurpose.SHORT_STAY) {
      if (
        stayMode === StayMode.DAY &&
        (!dayRate || dayRate <= 0)
      ) {
        return res.status(400).json({
          success: false,
          message: "Day rate must be greater than zero.",
        });
      }

      if (
        stayMode === StayMode.OVERNIGHT &&
        (!nightRate || nightRate <= 0)
      ) {
        return res.status(400).json({
          success: false,
          message: "Night rate must be greater than zero.",
        });
      }

      if (
        stayMode === StayMode.DAY_AND_NIGHT &&
        (!dayNightRate || dayNightRate <= 0)
      ) {
        return res.status(400).json({
          success: false,
          message: "Day-and-night rate must be greater than zero.",
        });
      }

      if (
        stayMode === StayMode.FLEXIBLE &&
        !dayRate &&
        !nightRate &&
        !dayNightRate
      ) {
        return res.status(400).json({
          success: false,
          message:
            "At least one short-stay rate is required for flexible stays.",
        });
      }
    }

    const bedrooms =
      req.body.bedrooms !== undefined
        ? parsePositiveInteger(req.body.bedrooms, "bedrooms")
        : existing.bedrooms;

    const bathrooms =
      req.body.bathrooms !== undefined
        ? parsePositiveInteger(req.body.bathrooms, "bathrooms")
        : existing.bathrooms;

    const beds =
      req.body.beds !== undefined
        ? parsePositiveInteger(req.body.beds, "beds")
        : existing.beds;

    const maxGuests =
      req.body.maxGuests !== undefined
        ? parsePositiveInteger(req.body.maxGuests, "maxGuests")
        : existing.maxGuests;

    const rooms =
      req.body.rooms !== undefined
        ? parsePositiveInteger(req.body.rooms, "rooms")
        : existing.rooms;

    if (
      purpose === PropertyPurpose.SHORT_STAY &&
      (rooms === undefined || rooms === null || rooms <= 0)
    ) {
      return res.status(400).json({
        success: false,
        message: "Number of rooms must be greater than zero.",
      });
    }
    
    if (
      purpose === PropertyPurpose.SHORT_STAY &&
      (maxGuests === undefined || maxGuests === null || maxGuests <= 0)
    ) {
      return res.status(400).json({
        success: false,
        message: "Maximum guests must be greater than zero.",
      });
    }


    const available =
      req.body.available !== undefined
        ? parseBoolean(req.body.available, "available")
        : existing.available;

    const town =
      req.body.town !== undefined
        ? normalizeString(req.body.town)
        : existing.town;

    const area =
      req.body.area !== undefined
        ? normalizeString(req.body.area)
        : existing.area;

    const placeId =
      req.body.placeId !== undefined
        ? normalizeString(req.body.placeId)
        : existing.placeId;

    if (placeId) {
      const place = await prisma.place.findUnique({
        where: {
          id: placeId,
        },
      });

      if (!place) {
        return res.status(400).json({
          success: false,
          message: "Selected place does not exist.",
        });
      }

      if (place.countyId !== countyId) {
        return res.status(400).json({
          success: false,
          message: "Selected place does not belong to the selected county.",
        });
      }
    }

    const latitude =
      req.body.latitude !== undefined
        ? req.body.latitude === null || req.body.latitude === ""
          ? null
          : Number(req.body.latitude)
        : existing.latitude;

    const longitude =
      req.body.longitude !== undefined
        ? req.body.longitude === null || req.body.longitude === ""
          ? null
          : Number(req.body.longitude)
        : existing.longitude;

    if (
      latitude !== null &&
      latitude !== undefined &&
      !Number.isFinite(latitude)
    ) {
      return res.status(400).json({
        success: false,
        message: "Invalid latitude.",
      });
    }

    if (
      longitude !== null &&
      longitude !== undefined &&
      !Number.isFinite(longitude)
    ) {
      return res.status(400).json({
        success: false,
        message: "Invalid longitude.",
      });
    }

    let amenityIds: string[] | undefined;

    if (req.body.amenityIds !== undefined) {
      amenityIds = normalizeStringArray(req.body.amenityIds);

      await validateAmenities(amenityIds);
    }

    /*
     * Marketer edits to a live/ACTIVE property must be reviewed
     * by an administrator before the property becomes ACTIVE again.
     *
     * CHANGES_REQUIRED means the marketer has received corrections
     * from admin, so saving the corrected property submits it again
     * for verification.
     *
     * DRAFT and PENDING_VERIFICATION keep their current status.
     */
    const requiresAdminReview =
      existing.status === PropertyStatus.ACTIVE ||
      existing.status === PropertyStatus.CHANGES_REQUIRED;

    const nextStatus = requiresAdminReview
      ? PropertyStatus.PENDING_VERIFICATION
      : existing.status;

    const property = await prisma.$transaction(async (tx) => {
      if (amenityIds !== undefined) {
        await tx.propertyAmenity.deleteMany({
          where: {
            propertyId: existing.id,
          },
        });
      }

      const updated = await tx.property.update({
        where: {
          id: existing.id,
        },
        data: {
          ...(title !== undefined ? { title } : {}),
          ...(req.body.description !== undefined
            ? { description }
            : {}),

          purpose,

          longStayType:
            purpose === PropertyPurpose.LONG_STAY
              ? longStayType
              : null,

          shortStayType:
            purpose === PropertyPurpose.SHORT_STAY
              ? shortStayType
              : null,

          stayMode:
            purpose === PropertyPurpose.SHORT_STAY
              ? stayMode
              : null,

          furnishing: furnishing ?? null,

          monthlyRent:
            purpose === PropertyPurpose.LONG_STAY
              ? monthlyRent ?? null
              : null,

          deposit:
            purpose === PropertyPurpose.LONG_STAY
              ? deposit ?? null
              : null,

          viewingFee: viewingFee ?? null,

          serviceCharge:
            purpose === PropertyPurpose.LONG_STAY
              ? serviceCharge ?? null
              : null,

          dayRate:
            purpose === PropertyPurpose.SHORT_STAY
              ? dayRate ?? null
              : null,

          nightRate:
            purpose === PropertyPurpose.SHORT_STAY
              ? nightRate ?? null
              : null,

          dayNightRate:
            purpose === PropertyPurpose.SHORT_STAY
              ? dayNightRate ?? null
              : null,

          countyId,
          constituencyId,
          wardId,

          ...(geography
            ? {
                county: geography.county.name,
              }
            : {}),

          ...(req.body.town !== undefined ? { town: town ?? "" } : {}),
          ...(req.body.area !== undefined ? { area: area ?? "" } : {}),
          ...(req.body.placeId !== undefined ? { placeId: placeId ?? null } : {}),
          ...(req.body.latitude !== undefined ? { latitude } : {}),
          ...(req.body.longitude !== undefined ? { longitude } : {}),

          bedrooms,
          bathrooms,
          beds,
          maxGuests,
          rooms:
            purpose === PropertyPurpose.SHORT_STAY
              ? rooms
              : null,

          available,

          status: nextStatus,

          ...(requiresAdminReview
            ? {
                verified: false,
                verifiedAt: null,
                verifiedById: null,
              }
            : {}),

          ...(amenityIds !== undefined
            ? {
                amenities: {
                  create: amenityIds.map((amenityId) => ({
                    amenityId,
                  })),
                },
              }
            : {}),
        },
        include: {
          countyRelation: true,
          constituency: true,
          ward: true,
          place: true,
          images: {
            orderBy: {
              sortOrder: "asc",
            },
          },
          amenities: {
            include: {
              amenity: true,
            },
          },
          statusHistory: {
            orderBy: {
              createdAt: "desc",
            },
          },
        },
      });

      if (requiresAdminReview) {
        await tx.propertyStatusHistory.create({
          data: {
            propertyId: existing.id,
            fromStatus: existing.status,
            toStatus: PropertyStatus.PENDING_VERIFICATION,
            note:
              existing.status === PropertyStatus.ACTIVE
                ? "Live property edited by marketer and submitted for admin verification"
                : "Property corrections submitted by marketer for verification",
            changedById: userId,
          },
        });
      }

      return updated;
    });

    return res.json({
      success: true,
      message: requiresAdminReview
        ? "Property updated and submitted for admin verification."
        : "Property updated successfully.",
      data: property,
    });
  } catch (error) {
    console.error("updateMarketerProperty error:", error);

    const message =
      error instanceof Error
        ? error.message
        : "Failed to update property.";

    return res.status(400).json({
      success: false,
      message,
    });
  }
}

/**
 * PATCH /api/marketer/properties/:id/status
 *
 * Marketer workflow:
 *
 * DRAFT -> PENDING_VERIFICATION
 * CHANGES_REQUIRED -> PENDING_VERIFICATION
 *
 * A marketer cannot activate/publish/reject a property.
 */
export async function updateMarketerPropertyStatus(
  req: AuthenticatedRequest,
  res: Response,
) {
  try {
    const userId = getAuthenticatedUserId(req);

    if (!userId) {
      return res.status(401).json({
        success: false,
        message: "Authentication required.",
      });
    }

    const marketer = await getMarketerFromUser(userId);

    if (!marketer) {
      return res.status(403).json({
        success: false,
        message: "Marketer profile not found.",
      });
    }

    const property = await prisma.property.findFirst({
      where: {
        id: String(req.params.id),
        marketerId: marketer.id,
      },
    });

    if (!property) {
      return res.status(404).json({
        success: false,
        message: "Property not found.",
      });
    }

    if (property.status === PropertyStatus.RENTED) {
      return res.status(400).json({
        success: false,
        message:
          "A rented property cannot be moved to another status.",
      });
    }

    const requestedStatus = normalizeString(
      req.body.status,
    )?.toUpperCase() as PropertyStatus | undefined;

    if (!requestedStatus) {
      return res.status(400).json({
        success: false,
        message: "Property status is required.",
      });
    }

    if (!ALLOWED_MARKETER_STATUSES.includes(requestedStatus)) {
      return res.status(403).json({
        success: false,
        message:
          "Marketers cannot set this property status. Only draft, pending verification and changes required are allowed.",
      });
    }

    const validTransition =
      (property.status === PropertyStatus.DRAFT &&
        requestedStatus ===
          PropertyStatus.PENDING_VERIFICATION) ||
      (property.status ===
        PropertyStatus.CHANGES_REQUIRED &&
        requestedStatus ===
          PropertyStatus.PENDING_VERIFICATION) ||
      (property.status === requestedStatus);

    if (!validTransition) {
      return res.status(400).json({
        success: false,
        message: `Invalid marketer status transition from ${property.status} to ${requestedStatus}.`,
      });
    }

    const note =
      typeof req.body.note === "string"
        ? req.body.note.trim()
        : undefined;

    const updated = await prisma.$transaction(
      async (tx) => {
        const result = await tx.property.update({
          where: {
            id: property.id,
          },
          data: {
            status: requestedStatus,
            verified: false,
            available:
              requestedStatus ===
                PropertyStatus.PENDING_VERIFICATION
                ? property.available
                : property.available,
          },
          include: {
            countyRelation: true,
            constituency: true,
            ward: true,
            images: {
              orderBy: {
                createdAt: "asc",
              },
            },
            amenities: {
              include: {
                amenity: true,
              },
            },
            statusHistory: {
              orderBy: {
                createdAt: "desc",
              },
            },
          },
        });

        if (property.status !== requestedStatus) {
          await tx.propertyStatusHistory.create({
            data: {
              propertyId: property.id,
              toStatus: requestedStatus,
              note:
                note ||
                (requestedStatus ===
                PropertyStatus.PENDING_VERIFICATION
                  ? "Property submitted by marketer for verification"
                  : "Property status updated by marketer"),
            },
          });
        }

        return result;
      },
    );

    return res.json({
      success: true,
      message:
        requestedStatus ===
        PropertyStatus.PENDING_VERIFICATION
          ? "Property submitted for verification."
          : "Property status updated.",
      data: updated,
    });
  } catch (error) {
    console.error(
      "updateMarketerPropertyStatus error:",
      error,
    );

    const message =
      error instanceof Error
        ? error.message
        : "Failed to update property status.";

    return res.status(400).json({
      success: false,
      message,
    });
  }
}

/**
 * PATCH /api/marketer/properties/:id/availability
 *
 * Marketer may change availability for their own property,
 * except when the property has already been marked RENTED.
 */
export async function updateMarketerPropertyAvailability(
  req: AuthenticatedRequest,
  res: Response,
) {
  try {
    const userId = getAuthenticatedUserId(req);

    if (!userId) {
      return res.status(401).json({
        success: false,
        message: "Authentication required.",
      });
    }

    const marketer = await getMarketerFromUser(userId);

    if (!marketer) {
      return res.status(403).json({
        success: false,
        message: "Marketer profile not found.",
      });
    }

    const property = await prisma.property.findFirst({
      where: {
        id: String(req.params.id),
        marketerId: marketer.id,
      },
    });

    if (!property) {
      return res.status(404).json({
        success: false,
        message: "Property not found.",
      });
    }

    if (property.status === PropertyStatus.RENTED) {
      return res.status(400).json({
        success: false,
        message:
          "A rented property cannot be made available again.",
      });
    }

    const available = parseBoolean(
      req.body.available,
      "available",
    );

    if (available === undefined) {
      return res.status(400).json({
        success: false,
        message: "The available field is required.",
      });
    }

    const updated = await prisma.property.update({
      where: {
        id: property.id,
      },
      data: {
        available,
      },
    });

    return res.json({
      success: true,
      message: available
        ? "Property marked as available."
        : "Property marked as unavailable.",
      data: updated,
    });
  } catch (error) {
    console.error(
      "updateMarketerPropertyAvailability error:",
      error,
    );

    const message =
      error instanceof Error
        ? error.message
        : "Failed to update property availability.";

    return res.status(400).json({
      success: false,
      message,
    });
  }
}
