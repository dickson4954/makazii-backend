/**
 * -------------------------------------------------------------
 * ADMIN → VIEW PRIVATE ID DOCUMENT
 * -------------------------------------------------------------
 *
 * GET /api/marketer-applications/admin/:id/id/front
 * GET /api/marketer-applications/admin/:id/id/back
 *
 * These documents are never exposed through a public URL.
 *
 * Authentication and admin authorization are enforced by
 * marketerApplicationRoutes.ts before this controller runs.
 */

export async function updateMarketerApplicationIdVerification(
  req: AuthenticatedRequest,
  res: Response,
) {
  try {
    const id = req.params.id as string;
    const { status, decision, message } = req.body ?? {};

    const normalizedStatus =
      typeof status === "string" ? status.trim().toUpperCase() : "";

    if (!["VERIFIED", "REJECTED", "REVIEW"].includes(normalizedStatus)) {
      return res.status(400).json({
        success: false,
        message: "Verification status must be VERIFIED, REJECTED, or REVIEW.",
      });
    }

    const application = await prisma.marketerApplication.findUnique({
      where: { id },
      select: {
        id: true,
        status: true,
      },
    });

    if (!application) {
      return res.status(404).json({
        success: false,
        message: "Marketer application not found",
      });
    }

    const verificationMessage =
      typeof message === "string" && message.trim()
        ? message.trim()
        : null;

    const verificationDecision =
      typeof decision === "string" && decision.trim()
        ? decision.trim()
        : normalizedStatus === "VERIFIED"
          ? "ID documents verified by admin"
          : normalizedStatus === "REJECTED"
            ? "ID documents rejected by admin"
            : "ID verification returned for review";

    const updated = await prisma.marketerApplication.update({
      where: { id },
      data: {
        idVerificationStatus: normalizedStatus as any,
        idVerificationDecision: verificationDecision,
        idVerificationMessage: verificationMessage,
        idVerifiedAt:
          normalizedStatus === "VERIFIED" ? new Date() : null,
      },
    });

    return res.json({
      success: true,
      message:
        normalizedStatus === "VERIFIED"
          ? "Identity documents verified successfully."
          : normalizedStatus === "REJECTED"
            ? "Identity documents rejected."
            : "Identity verification returned for review.",
      application: updated,
    });
  } catch (error) {
    console.error(
      "updateMarketerApplicationIdVerification error:",
      error,
    );

    return res.status(500).json({
      success: false,
      message: "Failed to update identity verification",
    });
  }
}

export async function getMarketerApplicationIdDocument(
  req: AuthenticatedRequest,
  res: Response,
  side: "front" | "back"
) {
  try {
    const id = req.params.id as string;

    const application =
      await prisma.marketerApplication.findUnique({
        where: {
          id,
        },

        select: {
          id: true,
          idFrontUrl: true,
          idBackUrl: true,
        },
      });

    if (!application) {
      return res.status(404).json({
        success: false,
        message:
          "Marketer application not found",
      });
    }

    const reference =
      side === "front"
        ? application.idFrontUrl
        : application.idBackUrl;

    const documentPath =
      resolvePrivateIdDocumentPath(
        application.id,
        reference,
        side
      );

    if (!documentPath) {
      return res.status(404).json({
        success: false,
        message:
          `Identity document (${side}) is not available`,
      });
    }

    try {
      await fs.access(documentPath);
    } catch {
      return res.status(404).json({
        success: false,
        message:
          `Identity document (${side}) could not be found`,
      });
    }

    const extension =
      path.extname(documentPath).toLowerCase();

    const contentType =
      extension === ".png"
        ? "image/png"
        : extension === ".webp"
          ? "image/webp"
          : "image/jpeg";

    /**
     * Identity documents are sensitive.
     *
     * Prevent browser/proxy caching and force inline
     * rendering for the admin document viewer.
     */
    res.setHeader(
      "Content-Type",
      contentType
    );

    res.setHeader(
      "Cache-Control",
      "private, no-store, no-cache, must-revalidate"
    );

    res.setHeader(
      "Pragma",
      "no-cache"
    );

    res.setHeader(
      "X-Content-Type-Options",
      "nosniff"
    );

    return res.sendFile(
      documentPath
    );
  } catch (error) {
    console.error(
      "getMarketerApplicationIdDocument error:",
      error
    );

    return res.status(500).json({
      success: false,
      message:
        "Failed to load identity document",
    });
  }
}

