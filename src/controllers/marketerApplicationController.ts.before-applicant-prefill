import type { Response } from "express";
import bcrypt from "bcryptjs";
import crypto from "node:crypto";
import fs from "node:fs/promises";
import path from "node:path";

import prisma from "../config/prisma";
import type { AuthenticatedRequest } from "../middleware/authMiddleware";
import {
  verifyMarketerIdentity,
  cleanupVerificationFiles,
} from "../services/idVerificationService";

/**
 * -------------------------------------------------------------
 * HELPERS
 * -------------------------------------------------------------
 */

/**
 * Express + Multer stores uploaded files in req.files.
 *
 * Because this controller receives multipart/form-data, normal
 * JSON booleans and arrays arrive as strings.
 */

type UploadedIdFiles = {
  idFront?: Express.Multer.File[];
  idBack?: Express.Multer.File[];
};

function getUploadedIdFiles(req: AuthenticatedRequest) {
  const files = req.files as UploadedIdFiles | undefined;

  return {
    front: files?.idFront?.[0] ?? null,
    back: files?.idBack?.[0] ?? null,
  };
}

/**
 * -------------------------------------------------------------
 * APPLICANT APPLICATION ACCESS
 * -------------------------------------------------------------
 *
 * Applicants do not have a MAKAZII account yet.
 *
 * The raw token is given to the applicant once after submission.
 * Only its SHA-256 hash is stored in the database.
 *
 * This prevents application status from being exposed through
 * email address, phone number, or application ID alone.
 */

function generateApplicationAccessToken() {
  const token = crypto.randomBytes(32).toString("hex");

  return {
    token,
    hash: crypto
      .createHash("sha256")
      .update(token)
      .digest("hex"),
  };
}

function hashApplicationAccessToken(
  token: string,
) {
  return crypto
    .createHash("sha256")
    .update(token)
    .digest("hex");
}

function getApplicationAccessToken(
  req: AuthenticatedRequest,
) {
  const authorization = req.headers.authorization;

  if (!authorization) {
    return null;
  }

  const [scheme, value] =
    authorization.split(" ");

  if (
    scheme?.toLowerCase() !== "bearer" ||
    !value?.trim()
  ) {
    return null;
  }

  return value.trim();
}

function parseBoolean(
  value: unknown
): boolean | undefined {
  if (typeof value === "boolean") {
    return value;
  }

  if (typeof value !== "string") {
    return undefined;
  }

  const normalized = value.trim().toLowerCase();

  if (normalized === "true") {
    return true;
  }

  if (normalized === "false") {
    return false;
  }

  return undefined;
}

function parseStringArray(
  value: unknown
): string[] {
  if (Array.isArray(value)) {
    return [
      ...new Set(
        value
          .filter(
            (item): item is string =>
              typeof item === "string"
          )
          .map((item) => item.trim())
          .filter(Boolean)
      ),
    ];
  }

  if (typeof value !== "string") {
    return [];
  }

  const trimmed = value.trim();

  if (!trimmed) {
    return [];
  }

  /**
   * Frontend may send JSON:
   *
   * ["one","two"]
   *
   * or comma-separated values:
   *
   * one,two
   */
  try {
    const parsed = JSON.parse(trimmed);

    if (Array.isArray(parsed)) {
      return [
        ...new Set(
          parsed
            .filter(
              (item): item is string =>
                typeof item === "string"
            )
            .map((item) => item.trim())
            .filter(Boolean)
        ),
      ];
    }
  } catch {
    // Not JSON. Continue with comma-separated parsing.
  }

  return [
    ...new Set(
      trimmed
        .split(",")
        .map((item) => item.trim())
        .filter(Boolean)
    ),
  ];
}

function parseNumber(
  value: unknown
): number | undefined {
  if (typeof value === "number" && Number.isFinite(value)) {
    return value;
  }

  if (typeof value !== "string" || !value.trim()) {
    return undefined;
  }

  const parsed = Number(value);

  return Number.isFinite(parsed)
    ? parsed
    : undefined;
}

async function safelyRemoveUploadedFile(
  file: Express.Multer.File | null
) {
  if (!file?.path) {
    return;
  }

  try {
    await fs.unlink(file.path);
  } catch {
    // File may already have been removed by the verification
    // cleanup helper. We intentionally ignore that case.
  }
}

/**
 * -------------------------------------------------------------
 * PRIVATE MARKETER ID STORAGE
 * -------------------------------------------------------------
 *
 * Identity documents are sensitive information.
 *
 * They are deliberately stored outside any public/static
 * directory. They are only accessible through authenticated
 * admin controller endpoints.
 */

const privateMarketerIdRoot =
  path.resolve(
    process.cwd(),
    "storage",
    "private",
    "marketer-ids"
  );

function getPrivateIdExtension(
  file: Express.Multer.File
): string {
  switch (file.mimetype) {
    case "image/png":
      return ".png";

    case "image/webp":
      return ".webp";

    case "image/jpeg":
    default:
      return ".jpg";
  }
}

async function persistMarketerIdDocuments(
  applicationId: string,
  frontFile: Express.Multer.File,
  backFile: Express.Multer.File
) {
  const applicationDirectory =
    path.join(
      privateMarketerIdRoot,
      applicationId
    );

  await fs.mkdir(
    applicationDirectory,
    {
      recursive: true,
    }
  );

  const frontExtension =
    getPrivateIdExtension(frontFile);

  const backExtension =
    getPrivateIdExtension(backFile);

  const frontTarget =
    path.join(
      applicationDirectory,
      `front${frontExtension}`
    );

  const backTarget =
    path.join(
      applicationDirectory,
      `back${backExtension}`
    );

  /**
   * rename() moves the temporary files into
   * permanent private storage.
   *
   * This means the temporary verification files
   * no longer exist at their original locations.
   */
  await fs.rename(
    frontFile.path,
    frontTarget
  );

  try {
    await fs.rename(
      backFile.path,
      backTarget
    );
  } catch (error) {
    /**
     * If the back document cannot be moved after
     * the front document has already moved, remove
     * the front document so we don't leave an
     * incomplete identity-document set behind.
     */
    try {
      await fs.unlink(frontTarget);
    } catch {
      // Ignore cleanup failure.
    }

    throw error;
  }

  return {
    frontReference:
      `private://marketer-ids/${applicationId}/front${frontExtension}`,

    backReference:
      `private://marketer-ids/${applicationId}/back${backExtension}`,

    frontPath: frontTarget,
    backPath: backTarget,
  };
}

function resolvePrivateIdDocumentPath(
  applicationId: string,
  reference: string | null | undefined,
  side: "front" | "back"
): string | null {
  if (
    typeof reference !== "string" ||
    !reference.startsWith(
      `private://marketer-ids/${applicationId}/`
    )
  ) {
    return null;
  }

  const relativeReference =
    reference.replace(
      `private://marketer-ids/${applicationId}/`,
      ""
    );

  /**
   * Only allow the exact front/back filename pattern
   * generated by persistMarketerIdDocuments().
   */
  if (
    side === "front" &&
    !/^front\.(jpg|jpeg|png|webp)$/.test(
      relativeReference
    )
  ) {
    return null;
  }

  if (
    side === "back" &&
    !/^back\.(jpg|jpeg|png|webp)$/.test(
      relativeReference
    )
  ) {
    return null;
  }

  const applicationDirectory =
    path.resolve(
      privateMarketerIdRoot,
      applicationId
    );

  const resolvedPath =
    path.resolve(
      applicationDirectory,
      relativeReference
    );

  /**
   * Prevent path traversal.
   */
  if (
    resolvedPath !== applicationDirectory &&
    !resolvedPath.startsWith(
      `${applicationDirectory}${path.sep}`
    )
  ) {
    return null;
  }

  return resolvedPath;
}

/**
 * -------------------------------------------------------------
 * PUBLIC → SUBMIT MARKETER APPLICATION
 * -------------------------------------------------------------
 *
 * POST /api/marketer-applications
 *
 * Applicants do not need an account.
 *
 * Request type:
 * multipart/form-data
 *
 * ID verification:
 * - actual ID front image required
 * - ID back image required for both supported ID types
 * - provider verification happens BEFORE application creation
 * - rejected identity documents are not saved as applications
 * - uncertain documents are saved with REVIEW verification status
 *
 * Geography rules:
 * - exactly one county
 * - exactly one constituency
 * - 1–2 wards
 * - constituency must belong to county
 * - wards must belong to constituency
 */
export async function submitMarketerApplication(
  req: AuthenticatedRequest,
  res: Response
) {
  const { front: idFrontFile, back: idBackFile } =
    getUploadedIdFiles(req);

  try {
    const body = req.body ?? {};

    const {
      firstName,
      lastName,
      phone,
      email,

      idType,
      idNumber,

      countyId,
      constituencyId,
      wardIds,

      timeInSelectedAreas,

      hasRealEstateExperience,
      experienceAreas,
      experienceDuration,
      experienceDescription,

      currentOccupation,
      workingWithAnotherAgency,
      currentAgencyName,

      motivation,
      contribution,
      expectedPropertiesPerMonth,

      propertySources,
      knowsLandlords,
      approximateLandlordCount,

      comfortableCommunicating,
      communicationMethods,
      timeAvailability,
      willingToFollowProcedures,

      referenceName,
      referencePhone,
      referenceRelationship,

      declarationAccepted,
    } = body;

    /**
     * ---------------------------------------------------------
     * BASIC REQUIRED FIELD VALIDATION
     * ---------------------------------------------------------
     */

    const requiredStrings: Array<
      [string, unknown]
    > = [
      ["First name", firstName],
      ["Last name", lastName],
      ["Phone", phone],
      ["Email", email],
      ["ID number", idNumber],
      ["Time in selected areas", timeInSelectedAreas],
      ["Experience duration", experienceDuration],
      ["Experience description", experienceDescription],
      ["Current occupation", currentOccupation],
      ["Motivation", motivation],
      ["Contribution", contribution],
      [
        "Expected properties per month",
        expectedPropertiesPerMonth,
      ],
      ["Time availability", timeAvailability],
      ["Reference name", referenceName],
      ["Reference phone", referencePhone],
      [
        "Reference relationship",
        referenceRelationship,
      ],
    ];

    for (const [label, value] of requiredStrings) {
      if (
        typeof value !== "string" ||
        !value.trim()
      ) {
        return res.status(400).json({
          success: false,
          message: `${label} is required`,
        });
      }
    }

    /**
     * ---------------------------------------------------------
     * ID TYPE
     * ---------------------------------------------------------
     */

    if (
      idType !== "NATIONAL_ID" &&
      idType !== "PASSPORT"
    ) {
      return res.status(400).json({
        success: false,
        message:
          "ID type must be NATIONAL_ID or PASSPORT",
      });
    }

    /**
     * ---------------------------------------------------------
     * PARSE MULTIPART BOOLEANS
     * ---------------------------------------------------------
     */

    const parsedHasRealEstateExperience =
      parseBoolean(hasRealEstateExperience);

    const parsedWorkingWithAnotherAgency =
      parseBoolean(workingWithAnotherAgency);

    const parsedKnowsLandlords =
      parseBoolean(knowsLandlords);

    const parsedComfortableCommunicating =
      parseBoolean(comfortableCommunicating);

    const parsedWillingToFollowProcedures =
      parseBoolean(willingToFollowProcedures);

    const parsedDeclarationAccepted =
      parseBoolean(declarationAccepted);

    if (
      parsedHasRealEstateExperience === undefined ||
      parsedWorkingWithAnotherAgency === undefined ||
      parsedKnowsLandlords === undefined ||
      parsedComfortableCommunicating === undefined ||
      parsedWillingToFollowProcedures === undefined
    ) {
      return res.status(400).json({
        success: false,
        message:
          "Experience, agency, landlord, communication, and procedure fields must be valid boolean values",
      });
    }

    if (parsedDeclarationAccepted !== true) {
      return res.status(400).json({
        success: false,
        message:
          "You must accept the declaration before submitting",
      });
    }

    /**
     * ---------------------------------------------------------
     * REQUIRED ID IMAGES
     * ---------------------------------------------------------
     *
     * These are actual uploaded files.
     *
     * We deliberately do NOT accept idFrontUrl/idBackUrl from
     * the public client anymore.
     */

    if (!idFrontFile) {
      return res.status(400).json({
        success: false,
        message:
          "The front image of your identity document is required",
      });
    }

    if (!idBackFile) {
      return res.status(400).json({
        success: false,
        message:
          "The back image of your identity document is required",
      });
    }

    if (!idFrontFile.path) {
      return res.status(400).json({
        success: false,
        message:
          "The uploaded ID front image could not be processed",
      });
    }

    if (!idBackFile.path) {
      return res.status(400).json({
        success: false,
        message:
          "The uploaded ID back image could not be processed",
      });
    }

    /**
     * ---------------------------------------------------------
     * EMAIL / PHONE
     * ---------------------------------------------------------
     */

    const normalizedEmail =
      email.trim().toLowerCase();

    const normalizedPhone =
      phone.trim();

    const existingUser =
      await prisma.user.findFirst({
        where: {
          OR: [
            {
              email: normalizedEmail,
            },
            {
              phone: normalizedPhone,
            },
          ],
        },
        select: {
          id: true,
          email: true,
          phone: true,
          role: true,
        },
      });

    if (existingUser) {
      return res.status(409).json({
        success: false,
        message:
          existingUser.email === normalizedEmail
            ? "An account with this email already exists"
            : "An account with this phone number already exists",
      });
    }

    /**
     * ---------------------------------------------------------
     * GEOGRAPHY VALIDATION
     * ---------------------------------------------------------
     */

    if (
      typeof countyId !== "string" ||
      !countyId.trim()
    ) {
      return res.status(400).json({
        success: false,
        message: "County is required",
      });
    }

    if (
      typeof constituencyId !== "string" ||
      !constituencyId.trim()
    ) {
      return res.status(400).json({
        success: false,
        message: "Constituency is required",
      });
    }

    const normalizedWardIds =
      parseStringArray(wardIds);

    if (
      normalizedWardIds.length < 1 ||
      normalizedWardIds.length > 2
    ) {
      return res.status(400).json({
        success: false,
        message: "Select between 1 and 2 wards",
      });
    }

    const county =
      await prisma.county.findUnique({
        where: {
          id: countyId.trim(),
        },
        select: {
          id: true,
          name: true,
        },
      });

    if (!county) {
      return res.status(400).json({
        success: false,
        message:
          "Selected county does not exist",
      });
    }

    const constituency =
      await prisma.constituency.findUnique({
        where: {
          id: constituencyId.trim(),
        },
        select: {
          id: true,
          name: true,
          countyId: true,
        },
      });

    if (!constituency) {
      return res.status(400).json({
        success: false,
        message:
          "Selected constituency does not exist",
      });
    }

    if (
      constituency.countyId !== county.id
    ) {
      return res.status(400).json({
        success: false,
        message:
          "Selected constituency does not belong to the selected county",
      });
    }

    const wards =
      await prisma.ward.findMany({
        where: {
          id: {
            in: normalizedWardIds,
          },
        },
        select: {
          id: true,
          name: true,
          constituencyId: true,
        },
      });

    if (
      wards.length !==
      normalizedWardIds.length
    ) {
      const foundIds = new Set(
        wards.map((ward) => ward.id)
      );

      const missingWardIds =
        normalizedWardIds.filter(
          (id) => !foundIds.has(id)
        );

      return res.status(400).json({
        success: false,
        message:
          "One or more selected wards do not exist",
        data: {
          missingWardIds,
        },
      });
    }

    const invalidWards =
      wards.filter(
        (ward) =>
          ward.constituencyId !==
          constituency.id
      );

    if (invalidWards.length > 0) {
      return res.status(400).json({
        success: false,
        message:
          "One or more selected wards do not belong to the selected constituency",
        data: {
          invalidWardIds:
            invalidWards.map(
              (ward) => ward.id
            ),
        },
      });
    }

    /**
     * ---------------------------------------------------------
     * DUPLICATE ACTIVE APPLICATION CHECK
     * ---------------------------------------------------------
     */

    const existingApplication =
      await prisma.marketerApplication.findFirst(
        {
          where: {
            OR: [
              {
                email: normalizedEmail,
              },
              {
                phone: normalizedPhone,
              },
            ],
            status: {
              in: [
                "PENDING",
                "UNDER_REVIEW",
                "ACTION_REQUIRED",
              ],
            },
          },
          select: {
            id: true,
            email: true,
            phone: true,
            status: true,
          },
        }
      );

    if (existingApplication) {
      return res.status(409).json({
        success: false,
        message:
          "You already have an active marketer application under review",
      });
    }

    /**
     * ---------------------------------------------------------
     * REAL IDENTITY VERIFICATION
     * ---------------------------------------------------------
     *
     * The actual uploaded images are sent to ID Analyzer.
     *
     * This happens BEFORE creating the database application.
     *
     * VERIFIED:
     *   Continue and create the application.
     *
     * REVIEW:
     *   Create the application, but mark identity
     *   verification as REVIEW so an administrator can inspect it.
     *
     * REJECTED:
     *   Do NOT create the application.
     */

    let verificationResult:
      Awaited<
        ReturnType<typeof verifyMarketerIdentity>
      > | null = null;

    try {
      verificationResult =
        await verifyMarketerIdentity({
          idType,
          idNumber: idNumber.trim(),
          firstName: firstName.trim(),
          lastName: lastName.trim(),
          frontPath: idFrontFile.path,
          backPath: idBackFile.path,
        });
    } catch (verificationError) {
      console.error(
        "Marketer identity verification error:",
        verificationError
      );

      return res.status(502).json({
        success: false,
        message:
          "We could not verify the identity document right now. Please try again.",
      });
    }

    /**
     * ---------------------------------------------------------
     * REJECTED ID
     * ---------------------------------------------------------
     */

    if (
      verificationResult.status ===
      "REJECTED"
    ) {
      return res.status(422).json({
        success: false,
        message:
          verificationResult.message ||
          "The identity document could not be verified. Please upload a valid document belonging to you.",
        data: {
          idVerificationStatus:
            "REJECTED",
        },
      });
    }

    /**
     * ---------------------------------------------------------
     * VERIFICATION RESULT VALUES
     * ---------------------------------------------------------
     *
     * Do not expose the raw provider response.
     * Only store the limited decision information required
     * for the Makazii workflow.
     */

    const idVerificationStatus =
      verificationResult.status ===
      "VERIFIED"
        ? "VERIFIED"
        : "REVIEW";

    const idVerificationDecision =
      typeof verificationResult.decision ===
      "string"
        ? verificationResult.decision
        : null;

    const idVerificationMessage =
      typeof verificationResult.message ===
      "string"
        ? verificationResult.message
        : null;

    const idVerificationTransactionId =
      typeof verificationResult.transactionId ===
      "string"
        ? verificationResult.transactionId
        : null;

    const idVerifiedAt =
      idVerificationStatus ===
      "VERIFIED"
        ? new Date()
        : null;

    /**
     * ---------------------------------------------------------
     * CREATE APPLICATION
     * ---------------------------------------------------------
     */

    const applicationAccess =
      generateApplicationAccessToken();

    const application =
      await prisma.marketerApplication.create({
        data: {
          firstName: firstName.trim(),
          lastName: lastName.trim(),
          phone: normalizedPhone,
          email: normalizedEmail,

          idType,
          idNumber: idNumber.trim(),

          /**
           * The actual private document references are added
           * immediately after the application receives its ID.
           *
           * We intentionally do not expose filesystem paths
           * or public URLs here.
           */
          idFrontUrl: null,
          idBackUrl: null,

          /**
           * ID verification result.
           */
          idVerificationStatus,
          idVerificationDecision,
          idVerificationMessage,
          idVerificationTransactionId,
          idVerifiedAt,

          countyId: county.id,
          constituencyId:
            constituency.id,
          wardIds: normalizedWardIds,

          timeInSelectedAreas:
            timeInSelectedAreas.trim(),

          hasRealEstateExperience:
            parsedHasRealEstateExperience,

          experienceAreas:
            parseStringArray(
              experienceAreas
            ),

          experienceDuration:
            experienceDuration.trim(),

          experienceDescription:
            experienceDescription.trim(),

          currentOccupation:
            currentOccupation.trim(),

          workingWithAnotherAgency:
            parsedWorkingWithAnotherAgency,

          currentAgencyName:
            typeof currentAgencyName ===
              "string" &&
            currentAgencyName.trim()
              ? currentAgencyName.trim()
              : null,

          motivation:
            motivation.trim(),

          contribution:
            contribution.trim(),

          expectedPropertiesPerMonth:
            expectedPropertiesPerMonth.trim(),

          propertySources:
            parseStringArray(
              propertySources
            ),

          knowsLandlords:
            parsedKnowsLandlords,

          approximateLandlordCount:
            parseNumber(
              approximateLandlordCount
            ) ?? null,

          comfortableCommunicating:
            parsedComfortableCommunicating,

          communicationMethods:
            parseStringArray(
              communicationMethods
            ),

          timeAvailability:
            timeAvailability.trim(),

          willingToFollowProcedures:
            parsedWillingToFollowProcedures,

          referenceName:
            referenceName.trim(),

          referencePhone:
            referencePhone.trim(),

          referenceRelationship:
            referenceRelationship.trim(),

          declarationAccepted: true,

          /**
           * Store only the hash. The raw token is never stored
           * in the database.
           */
          accessTokenHash:
            applicationAccess.hash,

          accessTokenCreatedAt:
            new Date(),
        },

        select: {
          id: true,
          firstName: true,
          lastName: true,
          email: true,
          phone: true,

          idType: true,
          idVerificationStatus: true,
          idVerificationDecision: true,
          idVerificationMessage: true,
          idVerificationTransactionId: true,
          idVerifiedAt: true,

          countyId: true,
          constituencyId: true,
          wardIds: true,
          status: true,
          createdAt: true,
        },
      });

    /**
     * ---------------------------------------------------------
     * MOVE ID DOCUMENTS INTO PRIVATE STORAGE
     * ---------------------------------------------------------
     *
     * At this point the application has an ID, so the
     * temporary verification files can be moved into a
     * permanent private directory belonging to this
     * application.
     */

    if (!idFrontFile || !idBackFile) {
      /**
       * This should already have been rejected earlier,
       * but keep this guard here so an application can
       * never exist without its required documents.
       */
      await prisma.marketerApplication.delete({
        where: {
          id: application.id,
        },
      });

      return res.status(400).json({
        success: false,
        message:
          "Identity documents are required for a marketer application.",
      });
    }

    let persistedDocuments:
      | Awaited<
          ReturnType<
            typeof persistMarketerIdDocuments
          >
        >
      | null = null;

    try {
      persistedDocuments =
        await persistMarketerIdDocuments(
          application.id,
          idFrontFile,
          idBackFile
        );

      await prisma.marketerApplication.update({
        where: {
          id: application.id,
        },

        data: {
          idFrontUrl:
            persistedDocuments.frontReference,

          idBackUrl:
            persistedDocuments.backReference,
        },
      });

      /**
       * The private document references are intentionally not
       * attached to the public application response.
       *
       * They remain stored in the database for admin-only
       * document access.
       */
    } catch (storageError) {
      console.error(
        "Failed to persist marketer identity documents:",
        storageError
      );

      /**
       * The application cannot safely proceed without
       * its identity documents, so remove the newly
       * created application and clean whatever document
       * files were successfully moved.
       */
      try {
        await prisma.marketerApplication.delete({
          where: {
            id: application.id,
          },
        });
      } catch (deleteError) {
        console.error(
          "Failed to remove incomplete marketer application:",
          deleteError
        );
      }

      if (persistedDocuments) {
        await safelyRemoveUploadedFile({
          path:
            persistedDocuments.frontPath,
        } as Express.Multer.File);

        await safelyRemoveUploadedFile({
          path:
            persistedDocuments.backPath,
        } as Express.Multer.File);
      }

      return res.status(500).json({
        success: false,
        message:
          "Your application could not be securely stored. Please try again.",
      });
    }

    /**
     * ---------------------------------------------------------
     * RESPONSE
     * ---------------------------------------------------------
     */

    return res.status(201).json({
      success: true,
      message:
        idVerificationStatus ===
        "VERIFIED"
          ? "Your marketer application has been submitted successfully"
          : "Your marketer application has been submitted and your identity document requires additional review",

      data: {
        application,

        /**
         * IMPORTANT:
         * This is the only time the raw application access
         * token is returned.
         *
         * The database contains only its SHA-256 hash.
         */
        applicationAccess: {
          token: applicationAccess.token,
          createdAt: new Date(),
        },

        geography: {
          county: {
            id: county.id,
            name: county.name,
          },

          constituency: {
            id: constituency.id,
            name: constituency.name,
          },

          wards: wards.map(
            (ward) => ({
              id: ward.id,
              name: ward.name,
            })
          ),
        },
      },
    });
  } catch (error) {
    console.error(
      "submitMarketerApplication error:",
      error
    );

    return res.status(500).json({
      success: false,
      message:
        "Failed to submit marketer application",
    });
  } finally {
    /**
     * ---------------------------------------------------------
     * CLEAN TEMPORARY ID FILES
     * ---------------------------------------------------------
     *
     * If document persistence succeeded, rename() already
     * moved the files and these paths no longer exist.
     *
     * If verification or application creation failed,
     * cleanupVerificationFiles() removes the temporary
     * verification files.
     */

    if (idFrontFile || idBackFile) {
      await cleanupVerificationFiles([
        idFrontFile?.path,
        idBackFile?.path,
      ].filter(
        (path): path is string =>
          typeof path === "string" &&
          Boolean(path)
      ));
    }
  }
}

/**
 * -------------------------------------------------------------
 * APPLICANT → GET OWN APPLICATION STATUS
 * -------------------------------------------------------------
 *
 * GET /api/marketer-applications/status
 *
 * Authorization:
 *   Bearer <application-access-token>
 *
 * This endpoint is intentionally separate from the admin
 * application endpoints.
 *
 * It returns only information that the applicant needs to
 * understand their application status. Private ID document
 * references are never returned here.
 */

export async function getApplicantMarketerApplicationStatus(
  req: AuthenticatedRequest,
  res: Response,
) {
  try {
    const token =
      getApplicationAccessToken(req);

    if (!token) {
      return res.status(401).json({
        success: false,
        message:
          "Application access token is required.",
      });
    }

    const tokenHash =
      hashApplicationAccessToken(token);

    const application =
      await prisma.marketerApplication.findUnique({
        where: {
          accessTokenHash: tokenHash,
        },
        select: {
          id: true,
          firstName: true,
          lastName: true,
          email: true,
          phone: true,

          idType: true,
          idVerificationStatus: true,
          idVerificationDecision: true,
          idVerificationMessage: true,
          idVerifiedAt: true,

          countyId: true,
          constituencyId: true,
          wardIds: true,

          status: true,
          adminNotes: true,
          rejectionReason: true,
          requestedChanges: true,

          reviewedAt: true,
          approvedAt: true,
          rejectedAt: true,

          createdAt: true,
          updatedAt: true,

          marketerId: true,
        },
      });

    if (!application) {
      return res.status(401).json({
        success: false,
        message:
          "Invalid or expired application access token.",
      });
    }

    const [county, constituency, wards] =
      await Promise.all([
        prisma.county.findUnique({
          where: {
            id: application.countyId,
          },
          select: {
            id: true,
            name: true,
          },
        }),

        prisma.constituency.findUnique({
          where: {
            id: application.constituencyId,
          },
          select: {
            id: true,
            name: true,
          },
        }),

        prisma.ward.findMany({
          where: {
            id: {
              in: application.wardIds,
            },
          },
          select: {
            id: true,
            name: true,
          },
        }),
      ]);

    return res.json({
      success: true,
      data: {
        application,
        geography: {
          county,
          constituency,
          wards,
        },
      },
    });
  } catch (error) {
    console.error(
      "getApplicantMarketerApplicationStatus error:",
      error,
    );

    return res.status(500).json({
      success: false,
      message:
        "Failed to load your marketer application status.",
    });
  }
}

