/**
 * -------------------------------------------------------------
 * ADMIN → APPROVE APPLICATION
 * -------------------------------------------------------------
 *
 * PATCH /api/admin/marketer-applications/:id/approve
 *
 * Creates:
 * 1. User
 * 2. Marketer
 * 3. MarketerCoverage
 *
 * Then activates the marketer account.
 */
export async function approveMarketerApplication(
  req: AuthenticatedRequest,
  res: Response
) {
  try {
    const id = req.params.id as string;

    const application =
      await prisma.marketerApplication.findUnique({
        where: {
          id,
        },
      });

    if (!application) {
      return res.status(404).json({
        success: false,
        message:
          "Marketer application not found",
      });
    }

    if (application.status === "APPROVED") {
      return res.status(400).json({
        success: false,
        message:
          "This application is already approved",
      });
    }

    if (application.status === "REJECTED") {
      return res.status(400).json({
        success: false,
        message:
          "A rejected application cannot be approved",
      });
    }

    /**
     * ---------------------------------------------------------
     * ID VERIFICATION CHECK BEFORE APPROVAL
     * ---------------------------------------------------------
     *
     * A marketer should not be activated if their identity
     * verification was rejected or has not been completed.
     */

    if (
      application.idVerificationStatus ===
      "REJECTED"
    ) {
      return res.status(400).json({
        success: false,
        message:
          "This marketer's identity verification was rejected. The application cannot be approved.",
      });
    }

    if (
      application.idVerificationStatus ===
      "REVIEW"
    ) {
      return res.status(400).json({
        success: false,
        message:
          "This marketer's identity verification requires additional review before approval.",
      });
    }

    if (
      application.idVerificationStatus !==
      "VERIFIED"
    ) {
      return res.status(400).json({
        success: false,
        message:
          "The marketer's identity has not been verified yet.",
      });
    }

    /**
     * ---------------------------------------------------------
     * RECHECK GEOGRAPHY BEFORE APPROVAL
     * ---------------------------------------------------------
     */

    const county =
      await prisma.county.findUnique({
        where: {
          id: application.countyId,
        },
        select: {
          id: true,
          name: true,
        },
      });

    const constituency =
      await prisma.constituency.findUnique({
        where: {
          id: application.constituencyId,
        },
        select: {
          id: true,
          name: true,
          countyId: true,
        },
      });

    if (!county || !constituency) {
      return res.status(400).json({
        success: false,
        message:
          "The application's selected geography is no longer valid",
      });
    }

    if (
      constituency.countyId !==
      county.id
    ) {
      return res.status(400).json({
        success: false,
        message:
          "The application's constituency does not belong to its county",
      });
    }

    const wardIds = [
      ...new Set(application.wardIds),
    ];

    if (
      wardIds.length < 1 ||
      wardIds.length > 2
    ) {
      return res.status(400).json({
        success: false,
        message:
          "The application must contain between 1 and 2 wards",
      });
    }

    const wards =
      await prisma.ward.findMany({
        where: {
          id: {
            in: wardIds,
          },
        },
        select: {
          id: true,
          name: true,
          constituencyId: true,
        },
      });

    if (
      wards.length !== wardIds.length
    ) {
      return res.status(400).json({
        success: false,
        message:
          "One or more wards in the application no longer exist",
      });
    }

    if (
      wards.some(
        (ward) =>
          ward.constituencyId !==
          constituency.id
      )
    ) {
      return res.status(400).json({
        success: false,
        message:
          "One or more application wards do not belong to the selected constituency",
      });
    }

    /**
     * ---------------------------------------------------------
     * CHECK COVERAGE CONFLICT
     * ---------------------------------------------------------
     *
     * Current business rule:
     * another marketer cannot already own any of these
     * selected geographic areas.
     */

    const existingCoverages =
      await prisma.marketerCoverage.findMany(
        {
          where: {
            OR: [
              {
                countyId: county.id,
              },
              {
                constituencyId:
                  constituency.id,
              },
            ],
          },
          include: {
            marketer: {
              include: {
                user: {
                  select: {
                    firstName: true,
                    lastName: true,
                    email: true,
                    phone: true,
                  },
                },
              },
            },
          },
        }
      );

    const conflictingCoverage =
      existingCoverages.find(
        (coverage) => {
          if (
            coverage.countyId !==
            county.id
          ) {
            return false;
          }

          if (
            coverage.constituencyId !==
            constituency.id
          ) {
            return false;
          }

          return coverage.wardIds.some(
            (wardId) =>
              wardIds.includes(wardId)
          );
        }
      );

    if (conflictingCoverage) {
      return res.status(409).json({
        success: false,
        message:
          "One or more selected wards are already assigned to another marketer",
        data: {
          conflictingMarketer: {
            firstName:
              conflictingCoverage
                .marketer.user
                .firstName,

            lastName:
              conflictingCoverage
                .marketer.user
                .lastName,
          },

          county:
            county.name,

          constituency:
            constituency.name,

          conflictingWardIds:
            conflictingCoverage.wardIds.filter(
              (wardId) =>
                wardIds.includes(
                  wardId
                )
            ),
        },
      });
    }

    /**
     * ---------------------------------------------------------
     * CHECK ACCOUNT CONFLICT AGAIN
     * ---------------------------------------------------------
     */

    const existingUser =
      await prisma.user.findFirst({
        where: {
          OR: [
            {
              email:
                application.email,
            },
            {
              phone:
                application.phone,
            },
          ],
        },
        select: {
          id: true,
          email: true,
          phone: true,
          role: true,
        },
      });

    if (existingUser) {
      return res.status(409).json({
        success: false,
        message:
          "A user account already exists with this application's email or phone number",
        data: {
          existingUserRole:
            existingUser.role,
        },
      });
    }

    /**
     * ---------------------------------------------------------
     * FIRST-TIME PASSWORD SETUP
     * ---------------------------------------------------------
     *
     * The marketer will create their own password.
     *
     * User.password is required, so we create a secure
     * internal password that is never shown to the marketer.
     *
     * A separate one-time setup token is created below.
     */

    const internalPassword =
      crypto
        .randomBytes(32)
        .toString("hex");

    const hashedPassword =
      await bcrypt.hash(
        internalPassword,
        12
      );

    /**
     * Generate a secure one-time password setup token.
     *
     * Only the SHA-256 hash is stored in the database.
     * The raw token is returned temporarily for development
     * testing. Later this can be delivered by email/SMS.
     */

    const passwordSetupToken =
      crypto
        .randomBytes(32)
        .toString("hex");

    const passwordSetupTokenHash =
      crypto
        .createHash("sha256")
        .update(passwordSetupToken)
        .digest("hex");

    const passwordSetupExpiresAt =
      new Date(
        Date.now() +
          24 * 60 * 60 * 1000
      );

    /**
     * ---------------------------------------------------------
     * CREATE USER + MARKETER + COVERAGE
     * ---------------------------------------------------------
     */

    const result =
      await prisma.$transaction(
        async (tx) => {
          const user =
            await tx.user.create({
              data: {
                firstName:
                  application.firstName,

                lastName:
                  application.lastName,

                email:
                  application.email,

                phone:
                  application.phone,

                password:
                  hashedPassword,

                role: "MARKETER",

                accountStatus: "ACTIVE",

                isActive: true,
              },
            });

          const marketer =
            await tx.marketer.create({
              data: {
                userId: user.id,
              },
            });

          const passwordSetup =
            await tx.passwordResetToken.create(
              {
                data: {
                  userId: user.id,

                  tokenHash:
                    passwordSetupTokenHash,

                  expiresAt:
                    passwordSetupExpiresAt,
                },
              }
            );

          const coverage =
            await tx.marketerCoverage.create(
              {
                data: {
                  marketerId:
                    marketer.id,

                  countyId:
                    county.id,

                  constituencyId:
                    constituency.id,

                  wardIds,
                },
              }
            );

          const updatedApplication =
            await tx.marketerApplication.update(
              {
                where: {
                  id:
                    application.id,
                },

                data: {
                  status:
                    "APPROVED",

                  marketerId:
                    marketer.id,

                  approvedAt:
                    new Date(),

                  reviewedAt:
                    application.reviewedAt ??
                    new Date(),
                },
              }
            );

          return {
            user,
            marketer,
            coverage,
            passwordSetup,
            application:
              updatedApplication,
          };
        }
      );

    return res.json({
      success: true,

      message:
        "Marketer application approved and marketer account created",

      data: {
        application:
          result.application,

        marketer: {
          id:
            result.marketer.id,

          userId:
            result.user.id,

          firstName:
            result.user.firstName,

          lastName:
            result.user.lastName,

          email:
            result.user.email,

          phone:
            result.user.phone,

          role:
            result.user.role,

          isActive:
            result.user.isActive,
        },

        coverage: {
          county:
            county.name,

          constituency:
            constituency.name,

          wards:
            wards.map(
              (ward) => ({
                id: ward.id,
                name: ward.name,
              })
            ),
        },

        passwordSetup: {
          token:
            passwordSetupToken,

          expiresAt:
            passwordSetupExpiresAt,
        },
      },
    });
  } catch (error) {
    console.error(
      "approveMarketerApplication error:",
      error
    );

    return res.status(500).json({
      success: false,
      message:
        "Failed to approve marketer application",
    });
  }
}