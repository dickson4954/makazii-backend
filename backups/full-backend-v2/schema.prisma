generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String   @unique
  phone     String?  @unique
  password  String
  role      UserRole @default(RENTER)

  // Account status
  accountStatus     AccountStatus @default(ACTIVE)
  statusReason      String?
  statusChangedAt   DateTime?
  statusChangedById String?

  // Kept for compatibility with existing authentication logic
  isActive Boolean @default(true)

  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  landlord           Landlord?
  marketer           Marketer?
  passwordResets     PasswordResetToken[]
  emailVerifications CustomerEmailVerification[]
  shortlists         Shortlist[]
  viewingRequests    ViewingRequest[]
  statusHistory      UserStatusHistory[]

  @@index([role])
  @@index([email])
  @@index([accountStatus])
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

model UserStatusHistory {
  id          String        @id @default(cuid())
  userId      String
  status      AccountStatus
  reason      String?
  changedById String?
  createdAt   DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model CustomerEmailVerification {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Landlord {
  id         String   @id @default(cuid())
  userId     String   @unique
  nationalId String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  properties Property[]
}

model Marketer {
  id        String   @id @default(cuid())
  userId    String   @unique
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  places      MarketerPlace[]
  properties  Property[]
  viewings    ViewingRequest[]     @relation("ViewingAssignedMarketer")
  coverage    MarketerCoverage?
  application MarketerApplication?

  // Marketer profile changes require admin approval
  profileChangeRequests MarketerProfileChangeRequest[]
}

model MarketerProfileChangeRequest {
  id         String @id @default(cuid())
  marketerId String

  // ---------------------------------------------------------
  // CURRENT VALUES AT THE TIME THE REQUEST WAS SUBMITTED
  // ---------------------------------------------------------
  currentFirstName String?
  currentLastName  String?
  currentEmail     String?
  currentPhone     String?

  // ---------------------------------------------------------
  // REQUESTED NEW VALUES
  // ---------------------------------------------------------
  requestedFirstName String?
  requestedLastName  String?
  requestedEmail     String?
  requestedPhone     String?

  // Reason supplied by the marketer
  reason String?

  // Request lifecycle
  status MarketerProfileChangeStatus @default(PENDING)

  // Admin review information
  adminNotes   String?
  reviewedAt   DateTime?
  reviewedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  marketer Marketer @relation(fields: [marketerId], references: [id], onDelete: Cascade)

  @@index([marketerId])
  @@index([status])
  @@index([createdAt])
}

enum MarketerProfileChangeStatus {
  PENDING
  APPROVED
  REJECTED
}

model MarketerCoverage {
  id             String   @id @default(cuid())
  marketerId     String   @unique
  countyId       String
  constituencyId String
  wardIds        String[]
  assignedAt     DateTime @default(now())
  updatedAt      DateTime @updatedAt

  marketer     Marketer     @relation(fields: [marketerId], references: [id], onDelete: Cascade)
  county       County       @relation(fields: [countyId], references: [id], onDelete: Cascade)
  constituency Constituency @relation(fields: [constituencyId], references: [id], onDelete: Cascade)
  properties   Property[]

  @@index([countyId])
  @@index([constituencyId])
}

model County {
  id        String   @id
  sourceId  String   @unique
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  constituencies    Constituency[]
  properties        Property[]
  places            Place[]
  marketerCoverages MarketerCoverage[]

  @@index([name])
}

model Constituency {
  id        String   @id
  sourceId  String   @unique
  name      String
  countyId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  county            County             @relation(fields: [countyId], references: [id], onDelete: Cascade)
  wards             Ward[]
  properties        Property[]
  marketerCoverages MarketerCoverage[]

  @@unique([countyId, name])
  @@index([countyId])
  @@index([name])
}

model Ward {
  id             String   @id
  sourceId       String   @unique
  name           String
  constituencyId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  constituency Constituency @relation(fields: [constituencyId], references: [id], onDelete: Cascade)
  properties   Property[]

  @@unique([constituencyId, name])
  @@index([constituencyId])
  @@index([name])
}

model Place {
  id        String   @id @default(cuid())
  name      String
  countyId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  county     County          @relation(fields: [countyId], references: [id], onDelete: Cascade)
  marketers  MarketerPlace[]
  properties Property[]

  @@unique([countyId, name])
  @@index([countyId])
}

model MarketerPlace {
  marketerId String
  placeId    String
  assignedAt DateTime @default(now())

  marketer Marketer @relation(fields: [marketerId], references: [id], onDelete: Cascade)
  place    Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@id([marketerId, placeId])
  @@index([placeId])
}

model Property {
  id           String         @id @default(cuid())
  title        String
  description  String?
  propertyType PropertyType
  status       PropertyStatus @default(DRAFT)
  rent         Int
  viewingFee   Int?
  deposit      Int?

  // ---------------------------------------------------------
  // KENYA GEOGRAPHY
  // ---------------------------------------------------------

  countyId       String
  constituencyId String
  wardId         String

  // Human-readable location details
  county String
  town   String
  area   String

  // Legacy compatibility only.
  // New property creation does not need this.
  placeId String?

  latitude  Float?
  longitude Float?
  bedrooms  Int?
  bathrooms Int?

  // true = available for customers
  // false = occupied/taken or otherwise unavailable
  available Boolean @default(true)

  // true = property has passed verification
  verified Boolean @default(false)

  // Landlord remains optional for now.
  landlordId String?
  marketerId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ---------------------------------------------------------
  // GEOGRAPHY RELATIONS
  // ---------------------------------------------------------

  countyRelation County       @relation(fields: [countyId], references: [id])
  constituency   Constituency @relation(fields: [constituencyId], references: [id])
  ward           Ward         @relation(fields: [wardId], references: [id])

  // ---------------------------------------------------------
  // OTHER RELATIONS
  // ---------------------------------------------------------

  landlord Landlord? @relation(fields: [landlordId], references: [id])
  marketer Marketer? @relation(fields: [marketerId], references: [id])
  place    Place?    @relation(fields: [placeId], references: [id], onDelete: SetNull)

  amenities          PropertyAmenity[]
  images             PropertyImage[]
  statusHistory      PropertyStatusHistory[]
  shortlists         Shortlist[]
  viewingRequests    ViewingRequest[]
  marketerCoverage   MarketerCoverage?       @relation(fields: [marketerCoverageId], references: [id])
  marketerCoverageId String?

  @@index([propertyType])
  @@index([status])
  @@index([countyId])
  @@index([constituencyId])
  @@index([wardId])
  @@index([county])
  @@index([town])
  @@index([area])
  @@index([placeId])
  @@index([rent])
  @@index([viewingFee])
  @@index([available])
  @@index([verified])
  @@index([landlordId])
  @@index([marketerId])
}

model PropertyImage {
  id         String   @id @default(cuid())
  propertyId String
  url        String
  publicId   String?
  altText    String?
  sortOrder  Int      @default(0)
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

model Amenity {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  properties PropertyAmenity[]
}

model PropertyAmenity {
  propertyId String
  amenityId  String

  amenity  Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@id([propertyId, amenityId])
  @@index([amenityId])
}

model Shortlist {
  id         String   @id @default(cuid())
  userId     String
  propertyId String
  createdAt  DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@index([userId])
  @@index([propertyId])
}

model ViewingRequest {
  id                 String             @id @default(cuid())
  propertyId         String
  renterId           String
  requestedDate      DateTime?
  preferredTime      String?
  notes              String?
  status             ViewingStatus      @default(REQUESTED)
  requestedBy        ViewingRequestedBy @default(RENTER)
  assignedMarketerId String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  assignedMarketer Marketer?              @relation("ViewingAssignedMarketer", fields: [assignedMarketerId], references: [id])
  property         Property               @relation(fields: [propertyId], references: [id])
  renter           User                   @relation(fields: [renterId], references: [id])
  statusHistory    ViewingStatusHistory[]

  @@index([propertyId])
  @@index([renterId])
  @@index([status])
  @@index([requestedDate])
  @@index([assignedMarketerId])
}

model ViewingStatusHistory {
  id        String        @id @default(cuid())
  viewingId String
  status    ViewingStatus
  note      String?
  createdAt DateTime      @default(now())

  viewing ViewingRequest @relation(fields: [viewingId], references: [id], onDelete: Cascade)

  @@index([viewingId])
}

model PropertyStatusHistory {
  id          String         @id @default(cuid())
  propertyId  String
  status      PropertyStatus
  note        String?
  changedById String?
  createdAt   DateTime       @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([changedById])
}

model MarketerApplication {
  id String @id @default(cuid())

  firstName String
  lastName  String
  phone     String
  email     String

  idType     MarketerIdType
  idNumber   String
  idFrontUrl String?
  idBackUrl  String?

  // ---------------------------------------------------------
  // IDENTITY VERIFICATION
  // ---------------------------------------------------------

  idVerificationStatus        MarketerIdVerificationStatus @default(PENDING)
  idVerificationDecision      String?
  idVerificationMessage       String?
  idVerificationTransactionId String?
  idVerifiedAt                DateTime?

  // ---------------------------------------------------------
  // MARKETER COVERAGE
  // ---------------------------------------------------------

  countyId       String
  constituencyId String
  wardIds        String[]
  placeIds       String[]

  timeInSelectedAreas String

  // ---------------------------------------------------------
  // EXPERIENCE
  // ---------------------------------------------------------

  hasRealEstateExperience Boolean
  experienceAreas         String[]
  experienceDuration      String
  experienceDescription   String

  // ---------------------------------------------------------
  // CURRENT WORK
  // ---------------------------------------------------------

  currentOccupation        String
  workingWithAnotherAgency Boolean
  currentAgencyName        String?

  // ---------------------------------------------------------
  // MOTIVATION / CONTRIBUTION
  // ---------------------------------------------------------

  motivation                 String
  contribution               String
  expectedPropertiesPerMonth String

  // ---------------------------------------------------------
  // PROPERTY SOURCES
  // ---------------------------------------------------------

  propertySources          String[]
  knowsLandlords           Boolean
  approximateLandlordCount Int?

  // ---------------------------------------------------------
  // COMMUNICATION
  // ---------------------------------------------------------

  comfortableCommunicating  Boolean
  communicationMethods      String[]
  timeAvailability          String
  willingToFollowProcedures Boolean

  // ---------------------------------------------------------
  // REFERENCE
  // ---------------------------------------------------------

  referenceName         String
  referencePhone        String
  referenceRelationship String

  // ---------------------------------------------------------
  // DECLARATION
  // ---------------------------------------------------------

  declarationAccepted Boolean

  marketerId String?   @unique
  marketer   Marketer? @relation(fields: [marketerId], references: [id], onDelete: SetNull)

  // ---------------------------------------------------------
  // APPLICATION STATUS
  // ---------------------------------------------------------

  status           MarketerApplicationStatus @default(PENDING)
  adminNotes       String?
  rejectionReason  String?
  requestedChanges String?

  reviewedAt DateTime?
  approvedAt DateTime?
  rejectedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([email])
  @@index([phone])
  @@index([countyId])
  @@index([constituencyId])
  @@index([createdAt])
  @@index([idVerificationStatus])
}

// -------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------

enum MarketerIdType {
  NATIONAL_ID
  PASSPORT
}

enum MarketerIdVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  REVIEW
}

enum MarketerApplicationStatus {
  PENDING
  UNDER_REVIEW
  ACTION_REQUIRED
  APPROVED
  REJECTED
}

enum UserRole {
  ADMIN
  STAFF
  MARKETER
  LANDLORD
  RENTER
}

enum PropertyType {
  SINGLE_ROOM
  BEDSITTER
  ONE_BEDROOM
  TWO_BEDROOM
  THREE_BEDROOM
}

enum PropertyStatus {
  DRAFT
  PENDING_VERIFICATION
  CHANGES_REQUIRED
  ACTIVE
  RENTED
  INACTIVE
  REJECTED
}

enum ViewingStatus {
  REQUESTED
  CONFIRMED
  ASSIGNED
  COMPLETED
  CANCELLED
  DECLINED
}

enum ViewingRequestedBy {
  RENTER
  ADMIN
  STAFF
  MARKETER
}
